---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "/{{ lang }}/index.html"
languages:
  - cn
  - tw
  - jp
  - kr
  - fr
  - de
  - es
  - pt
---

{% extends "base.njk" %}

{% block content %}
<main>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
        <path d="M5 3v4"></path>
        <path d="M19 17v4"></path>
        <path d="M3 5h4"></path>
        <path d="M17 19h4"></path>
      </svg>
      {{ homepage[lang].badge }}
    </div>
    <h1 class="hero-title">{{ homepage[lang].title }}</h1>
    <p class="hero-subtitle">{{ homepage[lang].subtitle }}</p>
    <div class="hero-search">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input type="text" id="tool-search" placeholder="{{ homepage[lang].searchPlaceholder }}" autocomplete="off">
    </div>
  </section>

  <!-- Tool Categories -->
  {% for cat in categories %}
  <section class="category-section" data-category="{{ cat.id }}" id="{{ cat.id }}">
    <div class="category-header">
      <div class="category-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {{ cat.icon | safe }}
        </svg>
      </div>
      <h2 class="category-title">{{ homepage[lang].categories[cat.id] or cat.name }}</h2>
    </div>
    <p class="category-desc">{% if homepage[lang].categoryDescs[cat.id] %}{{ homepage[lang].categoryDescs[cat.id] }}{% else %}{{ cat.description }}{% endif %}</p>
    <div class="tool-grid">
      {% for slug, tool in tools %}
        {% if tool.category == cat.id %}
          {% set linkPrefix = "/" + lang %}
          <a href="{{ linkPrefix }}/{{ slug }}" class="tool-card">
            <span class="tool-card-name">{{ homepage[lang].toolTitles[slug] or tool.title }}</span>
            <svg class="tool-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}

</main>
{% endblock %}

{% block scripts %}
  <script src="/js/main.js"></script>
{% endblock %}
