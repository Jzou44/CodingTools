<aside class="tool-sidebar">

  <!-- Related Tools Card -->
  <div class="sidebar-card">
    <h2 class="sidebar-card-title">Related Tools</h2>
    <ul class="related-tools-list">
      {% for slug, tool in tools %}
        {% if tool.category == 'hash-cryptography' %}
          <li>
            <a href="/{{ slug }}" {% if slug == activeTool %}class="active"{% endif %}>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {{ tool.icon | safe }}
              </svg>
              {{ tool.title }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Categories Card -->
  <div class="sidebar-card">
    <h2 class="sidebar-card-title">Categories</h2>
    <ul class="category-list">
      {% for cat in categories %}
        <li>
          <a href="/#{{ cat.id }}">
            <span class="category-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {{ cat.icon | safe }}
              </svg>
              {{ cat.name }}
            </span>
            <span class="category-count">{{ cat.count }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

</aside>
