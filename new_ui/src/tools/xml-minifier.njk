{% block description %}
  <h2>XML Minifier</h2>
  <p>This XML Minifier removes unnecessary whitespace, indentation, line breaks, and comments from XML documents to produce the most compact representation. It reduces file size for faster network transmission and lower storage requirements.</p>
  <p>The minification runs entirely in your browser. No XML data is uploaded to a server, making it safe for processing configuration files, API responses, sitemaps, or any XML content that may contain sensitive information.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Paste your formatted or pretty-printed XML into the input editor.</li>
    <li>Click <strong>Minify XML</strong> to strip whitespace and comments.</li>
    <li>View the compact XML in the output editor.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a .xml file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is XML minification?</h3>
  <p>XML minification is the process of removing all characters from an XML document that are not required for correct parsing. This includes stripping whitespace between tags, removing indentation, collapsing line breaks, and optionally removing comments.</p>
  <p>Minified XML is used in production environments where bandwidth and storage efficiency are important, such as SOAP web service payloads, RSS feeds, large configuration files, and data interchange between microservices.</p>

  <h3>Input notes</h3>
  <p>The tool accepts any well-formed XML input. It collapses whitespace between tags while preserving text content within elements. XML comments are removed during minification.</p>

  <h3>Example</h3>
  <p>Formatted XML is compressed by removing whitespace:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input (formatted) ---
&lt;root&gt;
  &lt;!-- User data --&gt;
  &lt;user id="1"&gt;
    &lt;name&gt;Alice&lt;/name&gt;
    &lt;email&gt;alice@example.com&lt;/email&gt;
  &lt;/user&gt;
&lt;/root&gt;

--- Output (minified) ---
&lt;root&gt;&lt;user id="1"&gt;&lt;name&gt;Alice&lt;/name&gt;&lt;email&gt;alice@example.com&lt;/email&gt;&lt;/user&gt;&lt;/root&gt;</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lineCount      = document.getElementById('line-count');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          outputEditor.value = htmlminifier.minify(text, {collapseWhitespace: true, minifyJS: true, minifyCSS: true, removeComments: true});
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'XML minified successfully');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Minification failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, lineCount, inputLineNums, outputLineNums);
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'result.xml');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
