---
lang: "cn"
toolId: "regex-tester"
category: "string-text-utilities"
activeTool: "regex-tester"
permalink: "/cn/regex-tester.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <label class="section-label" for="regex-input">{{ toolData.regexPattern }}</label>
  <div class="editor-wrapper" style="margin-bottom: 8px;">
    <textarea class="editor-area" id="regex-input" spellcheck="false" placeholder="{{ toolData.regexPlaceholder }}" rows="1"></textarea>
  </div>

  <div class="flags-row" style="margin-bottom: 20px;">
    <label class="checkbox-label"><input type="checkbox" id="flag-g" checked> <span>g</span> <small>{{ toolData.flagGlobal }}</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-i"> <span>i</span> <small>{{ toolData.flagCaseInsensitive }}</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-m"> <span>m</span> <small>{{ toolData.flagMultiline }}</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-s"> <span>s</span> <small>{{ toolData.flagDotAll }}</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-u"> <span>u</span> <small>{{ toolData.flagUnicode }}</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-y"> <span>y</span> <small>{{ toolData.flagSticky }}</small></label>
  </div>

  <label class="section-label" for="input-editor">{{ toolData.testText }}</label>
  <div class="editor-wrapper">
    <div class="line-numbers" id="input-line-numbers">1</div>
    <textarea class="editor-area" id="input-editor" spellcheck="false" placeholder="{{ toolData.inputPlaceholder }}"></textarea>
  </div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="btn btn-ghost" id="btn-clear" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
        {{ t.ui.clear }}
      </button>
    </div>
    <div class="toolbar-right">
      <button class="btn btn-ghost" id="btn-copy" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        {{ t.ui.copy }}
      </button>
      <button class="btn btn-ghost" id="btn-download" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {{ t.ui.download }}
      </button>
    </div>
  </div>

  <div style="margin-top: 24px;">
    <label class="section-label">{{ toolData.matchResults }}</label>
    <div id="match-output" class="highlight-box"></div>
  </div>

  <div class="status-bar">
    <div class="status-message idle" id="status-message">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
    <div class="status-meta">
      <span id="match-count">{{ toolData.noMatches }}</span>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var regexInput    = document.getElementById('regex-input');
      var inputEditor   = document.getElementById('input-editor');
      var matchOutput   = document.getElementById('match-output');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var matchCount    = document.getElementById('match-count');
      var inputLineNums = document.getElementById('input-line-numbers');
      var flagG         = document.getElementById('flag-g');
      var flagI         = document.getElementById('flag-i');
      var flagM         = document.getElementById('flag-m');
      var flagS         = document.getElementById('flag-s');
      var flagU         = document.getElementById('flag-u');
      var flagY         = document.getElementById('flag-y');

      function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function getFlags() {
        var flags = '';
        if (flagG.checked) flags += 'g';
        if (flagI.checked) flags += 'i';
        if (flagM.checked) flags += 'm';
        if (flagS.checked) flags += 's';
        if (flagU.checked) flags += 'u';
        if (flagY.checked) flags += 'y';
        return flags;
      }

      function runRegex() {
        var pattern = regexInput.value;
        var text = inputEditor.value;

        if (!pattern || !text) {
          matchOutput.innerHTML = text ? escapeHtml(text) : '<span class="muted">{{ toolData.matchesAppearHere }}</span>';
          matchCount.textContent = '{{ toolData.noMatches }}';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }

        try {
          var flags = getFlags();
          if (!flags.includes('g')) flags += 'g';
          var regex = new RegExp(pattern, flags);
          var matches = [];
          var match;

          while ((match = regex.exec(text)) !== null) {
            matches.push({ index: match.index, length: match[0].length, value: match[0] });
            if (match[0].length === 0) { regex.lastIndex++; }
            if (matches.length > 10000) break;
          }

          if (matches.length === 0) {
            matchOutput.innerHTML = escapeHtml(text);
            matchCount.textContent = '{{ toolData.noMatches }}';
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ toolData.noMatchesFound }}');
            return;
          }

          var html = '';
          var lastIdx = 0;
          for (var i = 0; i < matches.length; i++) {
            html += escapeHtml(text.substring(lastIdx, matches[i].index));
            html += '<mark>' + escapeHtml(matches[i].value) + '</mark>';
            lastIdx = matches[i].index + matches[i].length;
          }
          html += escapeHtml(text.substring(lastIdx));

          matchOutput.innerHTML = html;
          matchCount.textContent = matches.length + '{{ toolData.matchesSuffix }}';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', matches.length + '{{ toolData.matchesFoundSuffix }}');
        } catch (e) {
          matchOutput.innerHTML = '<span class="muted">{{ toolData.invalidRegex }}</span>';
          matchCount.textContent = '{{ toolData.noMatches }}';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ toolData.invalidRegex }}: ' + e.message);
        }
      }

      regexInput.addEventListener('input', runRegex);
      inputEditor.addEventListener('input', runRegex);
      [flagG, flagI, flagM, flagS, flagU, flagY].forEach(function (cb) {
        cb.addEventListener('change', runRegex);
      });

      btnClear.addEventListener('click', function () {
        regexInput.value = '';
        inputEditor.value = '';
        matchOutput.innerHTML = '<span class="muted">{{ toolData.matchesAppearHere }}</span>';
        matchCount.textContent = '{{ toolData.noMatches }}';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
        inputEditor.focus();
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(inputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(inputEditor, 'regex-test.txt');
      });

      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
    })();
  </script>
{% endblock %}
