{% if toolData.descTitle %}
<h2>{{ toolData.descTitle }}</h2>
{% endif %}

{% if toolData.descParas %}
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}
{% endif %}

{% if activeTool == "photo2pixel" or toolId == "photo2pixel" %}
<p>
  <a class="p2p-reference-link" href="https://github.com/Jzou44/photo2pixel" target="_blank" rel="noopener noreferrer">https://github.com/Jzou44/photo2pixel</a>
</p>
<figure class="p2p-demo-figure">
  <img src="/assets/img/photo2pixel-demo.png" alt="{{ toolData.demoAlt or 'Photo2Pixel 8-bit mountain pixel art demo' }}" loading="lazy">
</figure>
{% endif %}

{% if activeTool == "ascii-table" or toolId == "ascii-table" %}
  {% include "ascii-table-reference.njk" %}
{% endif %}

{% if toolData.howToUse and toolData.steps %}
<h3>{{ toolData.howToUse }}</h3>
<ol class="steps-list">
  {% for step in toolData.steps %}
  <li>{{ step | safe }}</li>
  {% endfor %}
</ol>
{% endif %}

{% if toolData.whatIs and toolData.whatIsParas %}
<h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}
{% endif %}

{% if toolData.inputNotes and toolData.inputNotesPara %}
<h3>{{ toolData.inputNotes }}</h3>
<p>{{ toolData.inputNotesPara | safe }}</p>
{% endif %}

{% if toolData.example and toolData.examplePara and toolData.exampleCode %}
<h3>{{ toolData.example }}</h3>
<p>{{ toolData.examplePara | safe }}</p>
<div class="code-block-wrapper">
  <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample or "Copy" }}</button>
  <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
</div>
{% endif %}
