<footer class="footer">
  <div class="footer-brand">&copy; {{ currentYear }} Coding.Tools</div>
  <div class="footer-tagline">{{ homepage[lang].tagline or "Built for developers, by developers" }}</div>
  <div class="footer-languages">
    {% set pageSlug = activeTool or toolId %}
    {% for language in site.languages %}
    <a href="{{ language.id | pathFor(pageSlug) }}" lang="{{ language.htmlLang }}">{{ language.label }}</a>{% if not loop.last %}<span class="divider">|</span>{% endif %}
    {% endfor %}
  </div>
</footer>
