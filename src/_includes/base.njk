<!DOCTYPE html>
{% set currentLang = lang or 'en' %}
{% set pageSlug = activeTool or toolId %}
{% set canonicalPath = currentLang | pathFor(pageSlug) %}
{% set canonicalUrl = canonicalPath | absoluteUrl %}
<html lang="{{ currentLang | htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description or title }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  {% for language in site.languages %}
  <link rel="alternate" hreflang="{{ language.htmlLang }}" href="{{ (language.id | pathFor(pageSlug)) | absoluteUrl }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ ('en' | pathFor(pageSlug)) | absoluteUrl }}">
  <meta property="og:type" content="{% if pageSlug %}website{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="{{ site.siteName }}">
  <meta property="og:image" content="{{ site.ogImage | absoluteUrl }}">
  <meta property="og:locale" content="{{ currentLang | htmlLang }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description or title }}">
  <meta name="twitter:image" content="{{ site.ogImage | absoluteUrl }}">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/favicons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/favicons/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/assets/favicons/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="apple-touch-icon" href="/assets/favicons/apple-touch-icon.png">
  <link rel="manifest" href="/assets/favicons/site.webmanifest">
  <meta name="theme-color" content="#c45d3a">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  {% if pageSlug %}
  {% seoJsonLd "tool", currentLang, pageSlug, title, description, toolTitle, categoryName, category, categories %}
  {% else %}
  {% seoJsonLd "home", currentLang, "", title, description, "", "", "", categories %}
  {% endif %}
  {% block head_extra %}{% endblock %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9943650245548204"
    crossorigin="anonymous"></script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5BEW8XFBSR"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-5BEW8XFBSR');
  </script>
  <noscript>
    <style>
      .category-section, .tool-card {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</head>
<body>

  {% include "navbar.njk" %}

  {% block content %}{% endblock %}

  {% block footer %}
    {% include "footer.njk" %}
  {% endblock %}

  {% block scripts %}{% endblock %}
</body>
</html>
