{% set pageLang = homeLang or lang or 'en' %}
{% set pageHome = homeData or homepage[pageLang] or homepage.en %}
{% set ui = t[pageLang].ui %}

<main id="main-content" tabindex="-1">

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
        <path d="M5 3v4"></path>
        <path d="M19 17v4"></path>
        <path d="M3 5h4"></path>
        <path d="M17 19h4"></path>
      </svg>
      {{ pageHome.badge }}
    </div>
    <h1 class="hero-title">{{ pageHome.title }}</h1>
    <p class="hero-subtitle">{{ pageHome.subtitle }}</p>
    <div class="hero-search">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input type="search" id="tool-search" placeholder="{{ pageHome.searchPlaceholder }}" aria-label="{{ pageHome.searchPlaceholder }}" autocomplete="off" aria-describedby="search-status" aria-keyshortcuts="/">
      <kbd class="search-shortcut" aria-hidden="true">/</kbd>
    </div>
    <p class="search-status" id="search-status" role="status" aria-live="polite" data-template="{{ ui.searchResults }}"></p>
  </section>

  <nav class="category-filters" aria-label="{{ ui.categories }}" hidden>
    <button type="button" class="category-filter is-active" data-filter="all" aria-pressed="true">{{ ui.allTools }} <span>{{ tools | length }}</span></button>
    {% for cat in categories %}
    <button type="button" class="category-filter" data-filter="{{ cat.id }}" aria-pressed="false">{{ pageHome.categories[cat.id] }} <span>{{ cat.count }}</span></button>
    {% endfor %}
  </nav>
  <section class="search-empty" id="search-empty" hidden>
    <span class="empty-icon" aria-hidden="true">⌕</span>
    <h2>{{ ui.noSearchResults }}</h2>
    <p>{{ ui.searchAgain }}</p>
    <button class="reset-search" type="button">{{ ui.resetSearch }}</button>
  </section>

  <!-- Tool Categories -->
  {% for cat in categories %}
  <section class="category-section" data-category="{{ cat.id }}" id="{{ cat.id }}">
    <div class="category-header">
      <div class="category-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {{ cat.icon | safe }}
        </svg>
      </div>
      <h2 class="category-title">{{ (pageHome.categories and pageHome.categories[cat.id]) or cat.name }}</h2>
      <span class="category-total">{{ cat.count }}</span>
    </div>
    <p class="category-desc">{{ (pageHome.categoryDescs and pageHome.categoryDescs[cat.id]) or cat.description }}</p>
    <div class="tool-grid">
      {% for slug, tool in tools %}
        {% if tool.category == cat.id %}
          <a href="{{ pageLang | pathFor(slug) }}" class="tool-card" data-search="{{ slug }} {{ tool.title }}">
            <span class="tool-card-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ tool.icon | safe }}</svg></span>
            <span class="tool-card-name">{{ (pageHome.toolTitles and pageHome.toolTitles[slug]) or tool.title }}</span>
            <svg class="tool-card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}

</main>
