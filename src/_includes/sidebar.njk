<aside class="tool-sidebar">

  <!-- Related Tools Card -->
  <div class="sidebar-card" aria-labelledby="related-tools-title">
    <div class="sidebar-card-title" id="related-tools-title">{% if lang and lang != 'en' %}{{ t.ui.relatedTools | default("Related Tools") }}{% else %}Related Tools{% endif %}</div>
    <ul class="related-tools-list">
      {% for slug, tool in tools %}
        {% if tool.category == category %}
          <li>
            {% set linkPrefix = "" %}
            {% if lang and lang != 'en' %}
              {% set linkPrefix = "/" + lang %}
            {% endif %}
            <a href="{{ (lang or 'en') | pathFor(slug) }}" {% if slug == activeTool %}class="active"{% endif %}>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {{ tool.icon | safe }}
              </svg>
              {% if sidebarToolTitles and sidebarToolTitles[slug] %}{{ sidebarToolTitles[slug] }}{% else %}{{ tool.title }}{% endif %}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Categories Card -->
  <div class="sidebar-card" aria-labelledby="categories-title">
    <div class="sidebar-card-title" id="categories-title">{% if lang and lang != 'en' %}{{ t.ui.categories | default("Categories") }}{% else %}Categories{% endif %}</div>
    <ul class="category-list">
      {% for cat in categories %}
        <li>
          <a href="{{ (lang or 'en') | pathFor }}#{{ cat.id }}">
            <span class="category-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {{ cat.icon | safe }}
              </svg>
              {% if lang and lang != 'en' and homepage[lang] and homepage[lang].categories[cat.id] %}{{ homepage[lang].categories[cat.id] }}{% else %}{{ cat.name }}{% endif %}
            </span>
            <span class="category-count">{{ cat.count }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

</aside>
