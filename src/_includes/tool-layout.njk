{% extends "base.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css">
{% endblock %}

{% block content %}
<div class="main-content">

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {% if lang and lang != 'en' %}
    <a href="/{{ lang }}/">{{ t.ui.home or "Home" }}</a>
    <span class="separator">/</span>
    <a href="/{{ lang }}/#{{ category }}">{{ categoryName }}</a>
    {% else %}
    <a href="/">Home</a>
    <span class="separator">/</span>
    <a href="/#{{ category }}">{{ categoryName }}</a>
    {% endif %}
    <span class="separator">/</span>
    <span class="current">{{ toolTitle }}</span>
  </nav>

  <!-- Tool Header -->
  <header class="tool-header">
    <h1>{{ toolTitle }}</h1>
    <p>{{ toolDescription }}</p>
  </header>

  <!-- Two-Column Layout -->
  <div class="tool-layout">

    <!-- Left Column — Tool Interface -->
    <div class="tool-main">
      {% block tool_content %}{% endblock %}

      <!-- Description Section -->
      <section class="description-section">
        {% block description %}{% endblock %}
      </section>
    </div>

    <!-- Right Column — Sidebar -->
    {% include "sidebar.njk" %}

  </div>

</div>
{% endblock %}

{% block scripts %}
  <script>
    window.I18N = {
      charSingular: '{{ t.ui.character or "character" }}',
      charPlural:   '{{ t.ui.characters or "characters" }}',
      lineSingular: '{{ t.ui.line or "line" }}',
      linePlural:   '{{ t.ui.lines or "lines" }}',
      byteSingular: '{{ t.ui.byte or "byte" }}',
      bytePlural:   '{{ t.ui.bytes or "bytes" }}',
      copied:       '{{ t.ui.copied or "Copied!" }}',
      copy:         '{{ t.ui.copy or "Copy" }}'
    };
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/bignumber-lite.js"></script>
  <script src="/js/tool-common.js"></script>
  <script src="/js/html-minifier-compat.js"></script>
  {% block tool_script %}{% endblock %}
{% endblock %}
