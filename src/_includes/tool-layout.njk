{% extends "base.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
{% endblock %}

{% block content %}
<main class="main-content">

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {% if lang and lang != 'en' %}
    <a href="{{ lang | pathFor }}">{{ t.ui.home or "Home" }}</a>
    <span class="separator">/</span>
    <a href="{{ lang | pathFor }}#{{ category }}">{{ categoryName }}</a>
    {% else %}
    <a href="{{ 'en' | pathFor }}">Home</a>
    <span class="separator">/</span>
    <a href="{{ 'en' | pathFor }}#{{ category }}">{{ categoryName }}</a>
    {% endif %}
    <span class="separator">/</span>
    <span class="current">{{ toolTitle }}</span>
  </nav>

  <!-- Tool Header -->
  <header class="tool-header">
    <div class="tool-header-copy">
      <h1>{{ toolTitle }}</h1>
      <p>{{ toolDescription }}</p>
    </div>
    <button
      class="sidebar-toggle"
      id="sidebar-toggle"
      type="button"
      aria-controls="tool-sidebar"
      aria-expanded="true"
      aria-label="{{ t.ui.hideSidebar or 'Hide sidebar' }}"
      title="{{ t.ui.hideSidebar or 'Hide sidebar' }}"
      data-show-label="{{ t.ui.showSidebar or 'Show sidebar' }}"
      data-hide-label="{{ t.ui.hideSidebar or 'Hide sidebar' }}">
      <span class="sidebar-toggle-icon" aria-hidden="true">
        <svg class="sidebar-toggle-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M15 3v18"></path>
          <path d="m10 9-3 3 3 3"></path>
        </svg>
        <svg class="sidebar-toggle-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M15 3v18"></path>
          <path d="m7 9 3 3-3 3"></path>
        </svg>
      </span>
      <span class="sidebar-toggle-label">{{ t.ui.sidebar or "Sidebar" }}</span>
    </button>
  </header>

  <!-- Two-Column Layout -->
  <div class="tool-layout" id="tool-layout" data-tool-layout>

    <!-- Left Column — Tool Interface -->
    <div class="tool-main">
      {% block tool_content %}{% endblock %}

      <!-- Description Section -->
      <section class="description-section">
        {% block description %}{% endblock %}
        {% include "mcp-integration-section.njk" %}
      </section>
    </div>

    <!-- Right Column — Sidebar -->
    {% include "sidebar.njk" %}

  </div>

</main>
{% endblock %}

{% block scripts %}
  {% set currentTool = activeTool or toolId %}
  {% set bigNumberTools = [
    "binary-to-decimal",
    "binary-to-hex",
    "decimal-to-binary",
    "decimal-to-hex",
    "decimal-to-octal",
    "decimal-to-percent",
    "fraction-to-decimal",
    "fraction-to-percent",
    "hex-to-binary",
    "hex-to-decimal",
    "octal-to-decimal",
    "percent-to-decimal"
  ] %}
  {% set htmlCompatTools = [
    "css-minifier",
    "html-minifier",
    "javascript-minifier",
    "json-to-xml",
    "xml-formatter",
    "xml-minifier",
    "xml-to-json"
  ] %}
  <script>
    window.I18N = {
      charSingular: '{{ t.ui.character or "character" }}',
      charPlural:   '{{ t.ui.characters or "characters" }}',
      lineSingular: '{{ t.ui.line or "line" }}',
      linePlural:   '{{ t.ui.lines or "lines" }}',
      byteSingular: '{{ t.ui.byte or "byte" }}',
      bytePlural:   '{{ t.ui.bytes or "bytes" }}',
      copied:       '{{ t.ui.copied or "Copied!" }}',
      copy:         '{{ t.ui.copy or "Copy" }}'
    };
  </script>
  {% if currentTool in bigNumberTools %}
  <script src="/js/bignumber-lite.js?v={{ site.assetVersion }}"></script>
  {% endif %}
  <script src="/js/tool-common.js?v={{ site.assetVersion }}"></script>
  {% if currentTool in htmlCompatTools %}
  <script src="/js/html-minifier-compat.js?v={{ site.assetVersion }}"></script>
  {% endif %}
  <script>
    (function () {
      var layout = document.getElementById('tool-layout');
      var toggle = document.getElementById('sidebar-toggle');
      if (!layout || !toggle) return;

      var cookieName = 'coding_tools_sidebar';

      function readPreference() {
        var pairs = document.cookie ? document.cookie.split('; ') : [];
        for (var i = 0; i < pairs.length; i += 1) {
          var parts = pairs[i].split('=');
          if (decodeURIComponent(parts[0]) === cookieName) {
            return decodeURIComponent(parts.slice(1).join('='));
          }
        }
        return null;
      }

      function savePreference(visible) {
        var value = visible ? 'visible' : 'hidden';
        document.cookie = cookieName + '=' + encodeURIComponent(value) + '; Max-Age=31536000; Path=/; SameSite=Lax';
      }

      function setSidebarVisible(visible, persist) {
        var label = visible ? toggle.dataset.hideLabel : toggle.dataset.showLabel;
        layout.classList.toggle('sidebar-collapsed', !visible);
        toggle.classList.toggle('is-collapsed', !visible);
        toggle.setAttribute('aria-expanded', visible ? 'true' : 'false');
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
        if (persist) savePreference(visible);
      }

      setSidebarVisible(readPreference() !== 'hidden', false);

      toggle.addEventListener('click', function () {
        setSidebarVisible(layout.classList.contains('sidebar-collapsed'), true);
      });
    })();
  </script>
  {% block tool_script %}{% endblock %}
{% endblock %}
