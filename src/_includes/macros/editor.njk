{% macro inputEditor(placeholder, label) %}
<div class="pane-card pane-card--input">
  <div class="pane-label">
    <span><span class="pane-label-dot pane-label-dot--accent"></span>{{ label or "Input" }}</span>
  </div>
  <div class="pane-editor-wrapper">
    <div class="pane-line-numbers" id="input-line-numbers">1</div>
    <textarea class="pane-editor" id="input-editor" spellcheck="false" rows="12" placeholder="{{ placeholder }}"></textarea>
  </div>
</div>
{% endmacro %}

{% macro outputEditor(placeholder, label) %}
<div style="margin-top: 0;">
<div class="pane-card pane-card--output">
  <div class="pane-label">
    <span><span class="pane-label-dot pane-label-dot--secondary"></span>{{ label or "Output" }}</span>
  </div>
  <div class="pane-editor-wrapper">
    <div class="pane-line-numbers readonly-bg" id="output-line-numbers">1</div>
    <textarea class="pane-editor" id="output-editor" spellcheck="false" readonly rows="12" placeholder="{{ placeholder }}"></textarea>
  </div>
</div>
</div>
{% endmacro %}
