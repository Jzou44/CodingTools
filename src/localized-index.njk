---
pagination:
  data: site.localizedLanguageIds
  size: 1
  alias: lang
permalink: "{{ lang | pathFor }}"
eleventyComputed:
  title: "{{ homepage[lang].title }} — Coding.Tools"
  description: "{{ homepage[lang].subtitle }}"
---

{% extends "base.njk" %}

{% block content %}
{% set homeLang = lang %}
{% set homeData = homepage[lang] %}
{% include "homepage-content.njk" %}
{% endblock %}

{% block footer %}
{% set homeLang = lang %}
{% set homeData = homepage[lang] %}
{% include "homepage-footer.njk" %}
{% endblock %}

{% block scripts %}
  <script src="/js/main.js"></script>
{% endblock %}
