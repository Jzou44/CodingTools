{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
{% endblock %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Paste your CSS here...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
    <button class="btn btn-primary" id="btn-generate" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
      Minify CSS
    </button>
  {% endcall %}

  {{ editor.outputEditor("Minified CSS will appear here...") }}

  {{ status.statusBar("characters", "lines") }}
{% endblock %}

{% block description %}
  <h2>CSS Minifier</h2>
  <p>This CSS Minifier removes unnecessary whitespace, comments, line breaks, and redundant characters from stylesheets to produce the most compact representation. It reduces file size for faster page loads and improved performance scores.</p>
  <p>The minification runs locally in your browser using the html-minifier library. Your CSS code never leaves your device, making it safe for processing proprietary stylesheets, framework themes, or any CSS that may contain sensitive design tokens.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Paste your formatted CSS into the input editor.</li>
    <li>Click <strong>Minify CSS</strong> to strip whitespace and comments.</li>
    <li>View the compact CSS in the output editor.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a .css file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is CSS minification?</h3>
  <p>CSS minification is the process of removing all characters from a stylesheet that are not required for correct rendering. This includes stripping whitespace, removing comments, collapsing line breaks, and removing unnecessary semicolons or units where possible.</p>
  <p>Minified CSS is a standard practice in web performance optimization. Tools like cssnano, clean-css, and Lightning CSS are commonly used in build pipelines. This browser-based tool provides a quick way to minify individual stylesheets without a build tool.</p>

  <h3>Input notes</h3>
  <p>The tool accepts any valid CSS input. It wraps the CSS in style tags to leverage the html-minifier library's CSS minification capabilities, then strips the wrapper tags from the output. Comments and unnecessary whitespace are removed.</p>

  <h3>Example</h3>
  <p>Formatted CSS is compressed by removing whitespace and comments:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input (formatted) ---
/* Card component */
.card {
  background: #fff;
  border: 1px solid #ddd;
  padding: 16px;
  border-radius: 8px;
}

--- Output (minified) ---
.card{background:#fff;border:1px solid #ddd;padding:16px;border-radius:8px}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lineCount      = document.getElementById('line-count');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          var wrapped = '<style>' + text + '</style>';
          var minified = htmlminifier.minify(wrapped, {collapseWhitespace: true, minifyCSS: true, removeComments: true});
          outputEditor.value = minified.replace(/<\/?style>/g, '');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'CSS minified successfully');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Minification failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, lineCount, inputLineNums, outputLineNums);
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'result.css');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
