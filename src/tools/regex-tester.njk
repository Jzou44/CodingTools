{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  <!-- Regex Pattern Input -->
  <label class="section-label" for="regex-input">Regex Pattern</label>
  <div class="editor-wrapper" style="margin-bottom: 8px;">
    <textarea class="editor-area" id="regex-input" spellcheck="false" placeholder="Enter regex pattern, e.g. \b\w+@\w+\.\w+\b" rows="1"></textarea>
  </div>

  <!-- Flags -->
  <div class="flags-row" style="margin-bottom: 20px;">
    <label class="checkbox-label"><input type="checkbox" id="flag-g" checked> <span>g</span> <small>global</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-i"> <span>i</span> <small>case-insensitive</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-m"> <span>m</span> <small>multiline</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-s"> <span>s</span> <small>dotAll</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-u"> <span>u</span> <small>unicode</small></label>
    <label class="checkbox-label"><input type="checkbox" id="flag-y"> <span>y</span> <small>sticky</small></label>
  </div>

  {{ editor.inputEditor("Enter or paste text to test against...", "Test Text") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
  {% endcall %}

  <!-- Match Highlighting -->
  <div style="margin-top: 24px;">
    <label class="section-label">Match Results</label>
    <div id="match-output" class="highlight-box"></div>
  </div>

  {{ status.statusBar("characters", "matches", "match-count") }}
{% endblock %}

{% block description %}
  <h2>Regex Tester</h2>
  <p>This regular expression tester lets you write and validate regex patterns against sample text directly in your browser. All six standard JavaScript regex flags are available: global, case-insensitive, multiline, dotAll, unicode, and sticky. Matches are highlighted in real time so you can see exactly what your pattern captures.</p>
  <p>The regex runs locally in your browser. The text you enter is not uploaded, stored, or sent to a server, so you can test patterns privately and quickly without changing your workflow.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Type or paste a regex pattern into the <strong>Regex Pattern</strong> input field. You do not need to include the leading and trailing slashes.</li>
    <li>Select the flags you need: <strong>g</strong> (global), <strong>i</strong> (case-insensitive), <strong>m</strong> (multiline), <strong>s</strong> (dotAll), <strong>u</strong> (unicode), or <strong>y</strong> (sticky).</li>
    <li>Enter or paste your test text into the editor below.</li>
    <li>Matches are highlighted automatically. The match count appears in the status bar.</li>
    <li>Use <strong>Copy</strong> to copy the test text to the clipboard, <strong>Download</strong> to save it as a file, or <strong>Clear</strong> to reset everything.</li>
  </ol>

  <h3>What are regular expressions?</h3>
  <p>A regular expression (regex) is a sequence of characters that defines a search pattern. It is used for pattern matching within strings, such as finding specific words, validating formats like emails or phone numbers, or splitting text by complex delimiters.</p>
  <p>JavaScript implements regex natively via the <code>RegExp</code> object. The same syntax works in most programming languages with minor variations. Learning regex is a core skill for text processing, data cleaning, log parsing, and input validation.</p>

  <h3>Input notes</h3>
  <p>Enter the regex pattern without delimiters (no <code>/pattern/flags</code> syntax). The flags are controlled by the checkboxes. Invalid patterns are caught and an error message is shown instead of crashing the tool.</p>

  <h3>Example</h3>
  <p>A simple pattern to find email-like strings in text:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy example</button>
    <pre class="code-block" id="example-code">--- Pattern ---
\b\w+@\w+\.\w+\b

--- Flags ---
g (global)

--- Test Text ---
Contact us at support@example.com or sales@company.org.
Invalid: @missing.com or user@

--- Matches Found ---
2 matches:
  1. support@example.com
  2. sales@company.org</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var regexInput    = document.getElementById('regex-input');
      var inputEditor   = document.getElementById('input-editor');
      var matchOutput   = document.getElementById('match-output');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var matchCount    = document.getElementById('match-count');
      var inputLineNums = document.getElementById('input-line-numbers');
      var flagG         = document.getElementById('flag-g');
      var flagI         = document.getElementById('flag-i');
      var flagM         = document.getElementById('flag-m');
      var flagS         = document.getElementById('flag-s');
      var flagU         = document.getElementById('flag-u');
      var flagY         = document.getElementById('flag-y');

      function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function getFlags() {
        var flags = '';
        if (flagG.checked) flags += 'g';
        if (flagI.checked) flags += 'i';
        if (flagM.checked) flags += 'm';
        if (flagS.checked) flags += 's';
        if (flagU.checked) flags += 'u';
        if (flagY.checked) flags += 'y';
        return flags;
      }

      function runRegex() {
        var pattern = regexInput.value;
        var text = inputEditor.value;

        if (!pattern || !text) {
          matchOutput.innerHTML = text ? escapeHtml(text) : '<span class="muted">Matches will appear here...</span>';
          matchCount.textContent = '0 matches';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }

        try {
          var flags = getFlags();
          if (!flags.includes('g')) flags += 'g';
          var regex = new RegExp(pattern, flags);
          var matches = [];
          var match;

          if (flags.includes('y')) {
            var lastIndex = 0;
            while ((match = regex.exec(text)) !== null) {
              matches.push({ index: match.index, length: match[0].length, value: match[0] });
              if (match.index === lastIndex && match[0].length === 0) { regex.lastIndex++; }
              lastIndex = regex.lastIndex;
              if (matches.length > 10000) break;
            }
          } else {
            while ((match = regex.exec(text)) !== null) {
              matches.push({ index: match.index, length: match[0].length, value: match[0] });
              if (match[0].length === 0) { regex.lastIndex++; }
              if (matches.length > 10000) break;
            }
          }

          if (matches.length === 0) {
            matchOutput.innerHTML = escapeHtml(text);
            matchCount.textContent = '0 matches';
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'No matches found');
            return;
          }

          var html = '';
          var lastIndex = 0;
          for (var i = 0; i < matches.length; i++) {
            html += escapeHtml(text.substring(lastIndex, matches[i].index));
            html += '<mark>' + escapeHtml(matches[i].value) + '</mark>';
            lastIndex = matches[i].index + matches[i].length;
          }
          html += escapeHtml(text.substring(lastIndex));

          matchOutput.innerHTML = html;
          matchCount.textContent = matches.length + (matches.length === 1 ? ' match' : ' matches');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', matches.length + (matches.length === 1 ? ' match found' : ' matches found'));
        } catch (e) {
          matchOutput.innerHTML = '<span class="muted">Invalid regex pattern</span>';
          matchCount.textContent = '0 matches';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid regex: ' + e.message);
        }
      }

      regexInput.addEventListener('input', runRegex);
      inputEditor.addEventListener('input', runRegex);
      [flagG, flagI, flagM, flagS, flagU, flagY].forEach(function (cb) {
        cb.addEventListener('change', runRegex);
      });

      btnClear.addEventListener('click', function () {
        regexInput.value = '';
        inputEditor.value = '';
        matchOutput.innerHTML = '<span class="muted">Matches will appear here...</span>';
        matchCount.textContent = '0 matches';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
        inputEditor.focus();
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(inputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(inputEditor, 'regex-test.txt');
      });

      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
    })();
  </script>
{% endblock %}
