{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
  <script src="/js/vkbeautify.js"></script>
{% endblock %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Paste your JSON here...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
    <button class="btn btn-primary" id="btn-generate" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
      Convert to XML
    </button>
  {% endcall %}

  {{ editor.outputEditor("XML output will appear here...") }}

  {{ status.statusBar("characters", "lines") }}
{% endblock %}

{% block description %}
  <h2>JSON to XML Converter</h2>
  <p>This tool converts JSON data into well-formatted XML. It parses the JSON structure, maps keys to XML elements, and produces indented, readable XML output that preserves the hierarchy and data types of the original JSON.</p>
  <p>The conversion runs entirely in your browser using the JXON and vkbeautify libraries. Your data never leaves your device, making it ideal for quick data format migration or interoperability tasks.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Paste your JSON data into the input editor.</li>
    <li>Click <strong>Convert to XML</strong> to transform the data.</li>
    <li>View the formatted XML in the output editor with proper indentation.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a .xml file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is JSON to XML conversion?</h3>
  <p>JSON to XML conversion transforms data from JavaScript Object Notation format into eXtensible Markup Language format. JSON uses key-value pairs and arrays, while XML uses nested elements with tags, so the converter maps JSON keys to XML element names and JSON values to element text content.</p>
  <p>This conversion is useful when integrating systems that use different data formats, migrating data between JSON-based and XML-based APIs, or when you need XML output for tools like XSLT processors, SOAP services, or document generators.</p>

  <h3>Input notes</h3>
  <p>The tool accepts any valid JSON object or array. JSON keys become XML element names, and values become text content. Arrays are represented as repeated elements with the same tag name. The output is wrapped in a root element and formatted with indentation.</p>

  <h3>Example</h3>
  <p>A JSON object is converted to structured XML:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input (JSON) ---
{
  "user": {
    "name": "Alice",
    "age": 30
  }
}

--- Output (XML) ---
&lt;user&gt;
  &lt;name&gt;Alice&lt;/name&gt;
  &lt;age&gt;30&lt;/age&gt;
&lt;/user&gt;</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lineCount      = document.getElementById('line-count');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          var obj = JSON.parse(text);
          var wrapped = { RootDirectory: obj };
          var xmlStr = JXON.xmlToString(JXON.jsToXml(wrapped));
          xmlStr = xmlStr.replace(/<RootDirectory>/, '').replace(/<\/RootDirectory>[\s\S]*$/, '');
          outputEditor.value = vkbeautify.xml(xmlStr);
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted to XML successfully');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Conversion failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, lineCount, inputLineNums, outputLineNums);
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'result.xml');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
