---
lang: "cn"
toolId: "number-to-words"
category: "string-text-utilities"
activeTool: "number-to-words"
permalink: "/cn/number-to-words.html"
---

{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css">
  <script src="/js/numberToWords.min.js"></script>
  <style>
    .nc-secondary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }
    .nc-secondary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: border-color 0.3s;
    }
    .nc-secondary-card.has-result { border-color: var(--secondary); }
    .nc-secondary-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .nc-secondary-value {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 18px;
      font-weight: 500;
      color: var(--text-primary);
      word-break: break-all;
      min-height: 24px;
      line-height: 1.3;
    }
    .nc-secondary-value.empty {
      color: var(--text-muted);
      font-size: 14px;
      font-weight: 400;
      font-style: italic;
    }
    @media (max-width: 600px) {
      .nc-secondary-grid { grid-template-columns: 1fr; }
    }
  </style>
{% endblock %}

{% block tool_content %}
  <div class="tool-input-card" style="--tool-accent: var(--accent)">
    <div class="tool-label">{{ t.ui.number }}</div>
    <input type="text" class="tool-input-field" id="input-number" spellcheck="false" placeholder="{{ toolData.inputPlaceholder }}" autocomplete="off" />
    <div class="tool-hint">{{ t.ui.validDecimalDigits }} <code>0-9</code> ({{ t.ui.integer }})</div>
  </div>

  <div style="display: flex; gap: 8px; margin-top: 12px; align-items: center;">
    <button class="btn btn-ghost" id="btn-clear" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        <line x1="10" y1="11" x2="10" y2="17"></line>
        <line x1="14" y1="11" x2="14" y2="17"></line>
      </svg>
      {{ t.ui.clear }}
    </button>
    <div class="status-message idle" id="status-message" style="margin-left: auto;">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
  </div>

  <div style="margin-top: 24px;">
    <div class="tool-output-card" style="--tool-accent: var(--secondary)" id="output-card">
      <div class="tool-output-label">
        <span>{{ toolData.wordResult }}</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="{{ t.ui.copyToClipboard }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          {{ t.ui.copy }}
        </button>
      </div>
      <div class="tool-output-value empty" id="result-word">{{ toolData.resultPlaceholder }}</div>
    </div>

    <div class="nc-secondary-grid" style="margin-top: 12px;">
      <div class="nc-secondary-card" id="ordinal-word-card">
        <div class="nc-secondary-label">{{ toolData.ordinalWordResult }}</div>
        <div class="nc-secondary-value empty" id="result-ordinal-word">&mdash;</div>
      </div>
      <div class="nc-secondary-card" id="ordinal-num-card">
        <div class="nc-secondary-label">{{ toolData.ordinalNumberResult }}</div>
        <div class="nc-secondary-value empty" id="result-ordinal-number">&mdash;</div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}
  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>
  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}
  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>
  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputNumber       = document.getElementById('input-number');
      var resultWord        = document.getElementById('result-word');
      var resultOrdinalWord = document.getElementById('result-ordinal-word');
      var resultOrdinalNum  = document.getElementById('result-ordinal-number');
      var outputCard        = document.getElementById('output-card');
      var ordinalWordCard   = document.getElementById('ordinal-word-card');
      var ordinalNumCard    = document.getElementById('ordinal-num-card');
      var btnClear          = document.getElementById('btn-clear');
      var btnCopy           = document.getElementById('btn-copy');
      var statusMessage     = document.getElementById('status-message');
      var statusDot         = document.getElementById('status-dot');
      var statusText        = document.getElementById('status-text');
      function showPrimary(text, type) {
        resultWord.textContent = text;
        resultWord.className = 'tool-output-value';
        if (type === 'empty') resultWord.className += ' empty';
        else if (type === 'error') resultWord.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      function showSecondary(el, card, text) {
        el.textContent = text;
        el.className = 'nc-secondary-value';
        if (text && text !== '—') card.classList.add('has-result');
        else card.classList.remove('has-result');
      }

      function convert() {
        var raw = inputNumber.value.trim();
        if (!raw) {
          showPrimary('{{ toolData.resultPlaceholder }}', 'empty');
          showSecondary(resultOrdinalWord, ordinalWordCard, '—');
          showSecondary(resultOrdinalNum, ordinalNumCard, '—');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }

        var num = Number(raw);
        if (isNaN(num) || !isFinite(num) || num !== Math.floor(num)) {
          showPrimary('{{ toolData.invalidInput }}', 'error');
          showSecondary(resultOrdinalWord, ordinalWordCard, '—');
          showSecondary(resultOrdinalNum, ordinalNumCard, '—');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ toolData.invalidInput }}');
          return;
        }

        try {
          var word = numberToWords.toWords(num);
          var ordinalWord = numberToWords.toWordsOrdinal(num);
          var ordinalNum = numberToWords.toOrdinal(num);

          showPrimary(word, 'valid');
          showSecondary(resultOrdinalWord, ordinalWordCard, ordinalWord);
          showSecondary(resultOrdinalNum, ordinalNumCard, ordinalNum);

          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', '{{ toolData.convertedSuccess }}');
        } catch (e) {
          showPrimary('{{ toolData.conversionFailed }}' + e.message, 'error');
          showSecondary(resultOrdinalWord, ordinalWordCard, '—');
          showSecondary(resultOrdinalNum, ordinalNumCard, '—');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ toolData.conversionFailed }}' + e.message);
        }
      }

      inputNumber.addEventListener('input', convert);

      btnClear.addEventListener('click', function () {
        inputNumber.value = '';
        showPrimary('{{ toolData.resultPlaceholder }}', 'empty');
        showSecondary(resultOrdinalWord, ordinalWordCard, '—');
        showSecondary(resultOrdinalNum, ordinalNumCard, '—');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = resultWord.textContent;
        if (text && !resultWord.classList.contains('empty') && !resultWord.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> {{ t.ui.copied }}';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
