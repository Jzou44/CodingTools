{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css">
  <script src="https://cdn.jsdelivr.net/npm/jxon@2.0.0/dist/jxon.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/js-beautify@1.15.4/js/lib/beautify.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html-minifier@4.0.0/dist/htmlminifier.min.js"></script>
{% endblock %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Paste your XML here...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
    <button class="btn btn-primary" id="btn-generate" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
      Convert to JSON
    </button>
  {% endcall %}

  {{ editor.outputEditor("JSON output will appear here...") }}

  {{ status.statusBar("characters", "lines") }}
{% endblock %}

{% block description %}
  <h2>XML to JSON Converter</h2>
  <p>This tool converts XML data into well-formatted JSON. It parses the XML structure, maps elements to JSON keys, and produces indented, readable JSON output that preserves the hierarchy of the original document.</p>
  <p>The conversion runs entirely in your browser using the JXON and js-beautify libraries. Your data never leaves your device, making it ideal for quick data format migration or interoperability tasks between XML and JSON systems.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Paste your XML data into the input editor.</li>
    <li>Click <strong>Convert to JSON</strong> to transform the data.</li>
    <li>View the formatted JSON in the output editor with proper indentation.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a .json file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is XML to JSON conversion?</h3>
  <p>XML to JSON conversion transforms data from eXtensible Markup Language format into JavaScript Object Notation format. XML elements become JSON keys, text content becomes values, and nested elements become nested objects. Attributes are typically merged into the resulting object.</p>
  <p>This conversion is useful when integrating systems that use different data formats, consuming XML APIs in JavaScript applications, or migrating data from XML-based databases to JSON-based document stores like MongoDB.</p>

  <h3>Input notes</h3>
  <p>The tool accepts any well-formed XML input. It strips the XML declaration if present, wraps the content in a root element for parsing, and converts the resulting tree to JSON. The output is formatted with consistent indentation for readability.</p>

  <h3>Example</h3>
  <p>XML data is converted to a structured JSON object:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input (XML) ---
&lt;user&gt;
  &lt;name&gt;Alice&lt;/name&gt;
  &lt;age&gt;30&lt;/age&gt;
&lt;/user&gt;

--- Output (JSON) ---
{
  "user": {
    "name": "Alice",
    "age": "30"
  }
}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lineCount      = document.getElementById('line-count');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          var source = htmlminifier.minify(text, {collapseWhitespace: true, removeComments: true});
          source = source.replace(/<\?xml[^?]*\?>/, '');
          source = '<RootDirectory>' + source + '</RootDirectory>';
          var doc = JXON.stringToXml(source);
          var obj = JXON.xmlToJs(doc);
          var json = JSON.stringify(obj.rootdirectory || obj, null, 2);
          outputEditor.value = js_beautify(json, { indent_size: 2 });
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted to JSON successfully');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Conversion failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, lineCount, inputLineNums, outputLineNums);
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'result.json');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
