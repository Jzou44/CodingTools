{% extends "tool-layout.njk" %}

{% block tool_content %}
  <style>
    .pct-dec-converter {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Gradient accent bar override */
    .pct-dec-converter .tool-input-card::before {
      background: linear-gradient(90deg, var(--accent), #d4725a);
    }

    .pct-dec-input-wrap {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }
    .pct-dec-suffix {
      font-family: 'Fraunces', serif;
      font-size: 32px;
      font-weight: 700;
      color: var(--accent);
      opacity: 0.6;
    }

    .pct-dec-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .pct-dec-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .pct-dec-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(196, 93, 58, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .pct-dec-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(196, 93, 58, 0.4);
    }

    .pct-dec-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .pct-dec-toolbar-left,
    .pct-dec-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pct-dec-ref {
      margin-top: 24px;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
    }
    .pct-dec-ref-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 12px;
    }
    .pct-dec-ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 6px;
    }
    .pct-dec-ref-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      padding: 4px 0;
    }
    .pct-dec-ref-item .pct {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 500;
      color: var(--text-secondary);
      min-width: 40px;
    }
    .pct-dec-ref-item .arrow {
      color: inherit;
      font-size: 11px;
    }
    .pct-dec-ref-item .dec {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      color: var(--accent);
    }

    @media (max-width: 600px) {
      .pct-dec-suffix { font-size: 24px; }
    }
  </style>

  <div class="pct-dec-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">Percent</div>
      <div class="pct-dec-input-wrap">
        <input type="text" class="tool-input-field" id="percent-input" placeholder="Enter percent value..." spellcheck="false" autocomplete="off" autofocus>
        <span class="pct-dec-suffix">%</span>
      </div>
      <div class="tool-hint">Enter a value like <code>75</code> or <code>33.5</code></div>
    </div>

    <!-- Arrow -->
    <div class="pct-dec-arrow">
      <div class="pct-dec-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent); --tool-output-font-size: 36px; --tool-output-font-size-mobile: 28px;">
      <div class="tool-output-label">
        <span>Decimal</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="tool-output-value empty" id="decimal-output">Result will appear here</div>
    </div>

    <!-- Toolbar -->
    <div class="pct-dec-toolbar">
      <div class="pct-dec-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="pct-dec-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="pct-dec-ref">
      <div class="pct-dec-ref-title">Quick Reference</div>
      <div class="pct-dec-ref-grid">
        <div class="pct-dec-ref-item"><span class="pct">1%</span><span class="arrow">&rarr;</span><span class="dec">0.01</span></div>
        <div class="pct-dec-ref-item"><span class="pct">10%</span><span class="arrow">&rarr;</span><span class="dec">0.1</span></div>
        <div class="pct-dec-ref-item"><span class="pct">25%</span><span class="arrow">&rarr;</span><span class="dec">0.25</span></div>
        <div class="pct-dec-ref-item"><span class="pct">50%</span><span class="arrow">&rarr;</span><span class="dec">0.5</span></div>
        <div class="pct-dec-ref-item"><span class="pct">75%</span><span class="arrow">&rarr;</span><span class="dec">0.75</span></div>
        <div class="pct-dec-ref-item"><span class="pct">100%</span><span class="arrow">&rarr;</span><span class="dec">1</span></div>
        <div class="pct-dec-ref-item"><span class="pct">150%</span><span class="arrow">&rarr;</span><span class="dec">1.5</span></div>
        <div class="pct-dec-ref-item"><span class="pct">200%</span><span class="arrow">&rarr;</span><span class="dec">2</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>Percent to Decimal Converter</h2>
  <p>This tool converts a percentage value into its decimal equivalent. It is useful for financial calculations, statistics, scientific formulas, or any math problem that requires converting between percentage and decimal formats.</p>
  <p>The conversion is simple and runs entirely in your browser: divide the percentage by 100 to get the decimal value.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Enter a percentage value in the input field (e.g. <code>75</code> or <code>33.5</code>).</li>
    <li>Click <strong>Convert</strong> to see the decimal result.</li>
    <li>Use <strong>Copy</strong> to copy the result to your clipboard, or <strong>Clear</strong> to reset.</li>
  </ol>

  <h3>Formula</h3>
  <p>The conversion formula is straightforward: <code>decimal = percent / 100</code>. For example, <code>75%</code> becomes <code>75 / 100 = 0.75</code>.</p>

  <h3>Example</h3>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">Percent:  75%
Decimal:  0.75

Percent:  50%
Decimal:  0.5

Percent:  33.33%
Decimal:  0.3333</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var percentInput  = document.getElementById('percent-input');
      var decimalOutput = document.getElementById('decimal-output');
      var outputCard    = document.getElementById('output-card');
      var btnConvert    = document.getElementById('btn-convert');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      function showResult(text, type) {
        decimalOutput.textContent = text;
        decimalOutput.className = 'tool-output-value';
        if (type === 'empty') decimalOutput.className += ' empty';
        else if (type === 'error') decimalOutput.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      function convert() {
        var input = percentInput.value.trim();
        if (!input) return;
        try {
          var result = new BigNumber(input).dividedBy(100);
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
        } catch (e) {
          showResult('Invalid percent input', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid percent input');
        }
      }

      btnConvert.onclick = convert;

      btnClear.addEventListener('click', function () {
        percentInput.value = '';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = decimalOutput.textContent;
        if (text && !decimalOutput.classList.contains('empty') && !decimalOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      percentInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      percentInput.addEventListener('input', function () {
        var input = percentInput.value.trim();
        if (!input) {
          showResult('Result will appear here', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        try {
          var result = new BigNumber(input).dividedBy(100);
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
        } catch (e) {
          showResult('Invalid percent input', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid input');
        }
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
