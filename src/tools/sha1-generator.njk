{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Enter text to generate its SHA-1 hash...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
    <button class="btn btn-primary" id="btn-generate" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
      Generate
    </button>
  {% endcall %}

  {{ editor.outputEditor("SHA-1 hash will appear here...") }}

  {{ status.statusBar("characters", "lines") }}
{% endblock %}

{% block description %}
  <h2>SHA1 Generator</h2>
  <p>This SHA-1 generator creates a 160-bit hash digest from any text you enter. Paste or type your input, press Generate, and the tool produces the 40-character hexadecimal SHA-1 hash instantly in your browser.</p>
  <p>The hashing runs locally using the Web Crypto API built into every modern browser. Your input is never uploaded or stored on a server, so you can generate hashes privately and quickly without changing your workflow.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Type or paste text into the input editor.</li>
    <li>Click <strong>Generate SHA1</strong> to compute the hash digest.</li>
    <li>The 40-character hexadecimal hash appears in the output editor with a confirmation message.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a text file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is SHA-1?</h3>
  <p>SHA-1 (Secure Hash Algorithm 1) is a cryptographic hash function that produces a 160-bit (20-byte) hash value, typically rendered as a 40-character hexadecimal string. It was designed by the NSA and published by NIST in 1995.</p>
  <p>SHA-1 is deterministic: the same input always produces the same hash. It is a one-way function, meaning you cannot reverse a hash to recover the original input. While SHA-1 is no longer considered secure for digital signatures or certificate verification, it remains widely used for checksums, content addressing, and non-security-critical fingerprinting.</p>

  <h3>Common uses</h3>
  <p>SHA-1 hashes are used in Git commit identifiers, file integrity checks, data deduplication, and legacy systems that predate SHA-2. If you need a stronger hash for security purposes, consider using SHA-256 or SHA-512 instead.</p>

  <h3>Example</h3>
  <p>Here is how a short text message maps to its SHA-1 hash:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input Text ---
Hello, World!

--- SHA-1 Hash ---
0a0a9f2a6772942557ab5355d76af442f8f65e01</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lineCount      = document.getElementById('line-count');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = text.length === 40 ? '40 hex characters' : ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = async function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          var data = new TextEncoder().encode(text);
          var hashBuffer = await crypto.subtle.digest('SHA-1', data);
          var hashArray = Array.from(new Uint8Array(hashBuffer));
          var hashHex = hashArray.map(function (b) {
            return b.toString(16).padStart(2, '0');
          }).join('');
          outputEditor.value = hashHex;
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'SHA-1 hash generated — 40 hex characters');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Hash generation failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, lineCount, inputLineNums, outputLineNums);
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'sha1-hash.txt');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
