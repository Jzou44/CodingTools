{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Enter text to generate SHA-256 hash...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
    <button class="btn btn-primary" id="btn-generate" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
      Generate
    </button>
  {% endcall %}

  {{ editor.outputEditor("SHA-256 hash will appear here...") }}

  {{ status.statusBar("characters", "characters", "hash-length") }}
{% endblock %}

{% block description %}
  <h2>SHA256 Generator</h2>
  <p>
    This tool generates a SHA-256 hash from any text you provide. SHA-256 is a member of the
    SHA-2 family of cryptographic hash functions and produces a fixed 256-bit (64 hexadecimal
    character) digest regardless of the input length.
  </p>
  <p>
    The hash is computed locally in your browser using the Web Crypto API. Your input is never
    uploaded or stored on a server, making this tool suitable for quick verification tasks,
    integrity checks, and development workflows.
  </p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Type or paste your text into the input editor.</li>
    <li>Click <strong>Generate</strong> to produce the hash digest.</li>
    <li>The 64-character hexadecimal hash appears in the output editor.</li>
    <li>Use <strong>Copy</strong> for the clipboard, <strong>Download</strong> for a text file, or <strong>Clear</strong> to reset both editors.</li>
  </ol>

  <h3>What is SHA-256?</h3>
  <p>
    SHA-256 (Secure Hash Algorithm 256-bit) is a one-way cryptographic hash function designed
    by the NSA and published by NIST. It takes an input of any length and produces a fixed
    256-bit (32-byte) hash value, typically represented as a 64-character hexadecimal string.
  </p>
  <p>
    SHA-256 is widely used in digital signatures, certificate verification, password storage,
    and blockchain technology (including Bitcoin). It is considered collision-resistant, meaning
    it is computationally infeasible to find two different inputs that produce the same hash.
  </p>

  <h3>Input notes</h3>
  <p>
    The tool accepts any text, including Unicode characters, emojis, and multi-line content.
    Even a small change to the input — such as a single character — produces a completely
    different hash, a property known as the avalanche effect.
  </p>

  <h3>Example</h3>
  <p>Hashing a short phrase produces a fixed-length 64-character digest:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Input Text ---
Hello, World!

--- SHA-256 Hash ---
dffd6021bb2bd5b0af676290809ec3a53191dd81c7f70a4b28688a362182986f

--- Hash Length ---
64 characters (256 bits)</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor    = document.getElementById('input-editor');
      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var hashLength     = document.getElementById('hash-length');
      var inputLineNums  = document.getElementById('input-line-numbers');
      var outputLineNums = document.getElementById('output-line-numbers');

      function updateCounts() {
        var text = outputEditor.value;
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        hashLength.textContent = text.length === 64 ? '64 characters' : text.length + ' characters';
        ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
      }

      btnGenerate.onclick = async function () {
        var text = inputEditor.value;
        if (!text) return;
        try {
          var data = new TextEncoder().encode(text);
          var hashBuffer = await crypto.subtle.digest('SHA-256', data);
          var hashArray = Array.from(new Uint8Array(hashBuffer));
          var hashHex = hashArray.map(function (b) {
            return b.toString(16).padStart(2, '0');
          }).join('');
          outputEditor.value = hashHex;
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'SHA-256 hash generated — 64 hex characters');
          updateCounts();
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Hash generation failed: ' + e.message);
        }
      };

      btnClear.addEventListener('click', function () {
        ToolCommon.clearEditors(inputEditor, outputEditor, statusMessage, statusDot, statusText, charCount, null, inputLineNums, outputLineNums);
        hashLength.textContent = '0 characters';
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'sha256-hash.txt');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(outputEditor, outputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      ToolCommon.updateLineNumbers(outputEditor, outputLineNums);
    })();
  </script>
{% endblock %}
