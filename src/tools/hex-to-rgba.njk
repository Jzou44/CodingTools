---
category: "number-conversion"
activeTool: "hex-to-rgba"
permalink: "/hex-to-rgba.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}

  <div class="hex-rgba-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">Hex Color</div>
      <input type="text" class="tool-input-field" id="hex-input" placeholder="#FF5733" spellcheck="false" autocomplete="off" autofocus>
      <div class="hex-rgba-opacity-row">
        <span class="hex-rgba-opacity-label">Opacity</span>
        <input type="range" class="hex-rgba-opacity-slider" id="opacity-slider" min="0" max="100" value="100">
        <span class="hex-rgba-opacity-value" id="opacity-display">100%</span>
      </div>
      <div class="tool-hint">Enter a hex code like <code>#FF5733</code>, adjust opacity with the slider</div>
      <div class="hex-rgba-actions">
        <button class="btn btn-secondary" id="btn-random" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          Random
        </button>
      </div>
    </div>

    <!-- Arrow -->
    <div class="hex-rgba-arrow">
      <div class="hex-rgba-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent)">
      <div class="tool-output-label">
        <span>RGBA Value</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="tool-output-value empty" id="rgba-output" style="--tool-output-font-size: 24px; --tool-output-font-size-mobile: 20px; --tool-accent: var(--accent)">Result will appear here</div>

      <!-- RGBA Channels -->
      <div class="hex-rgba-channels" id="rgba-channels" style="display:none;">
        <div class="hex-rgba-channel">
          <div class="hex-rgba-channel-label">R</div>
          <div class="hex-rgba-channel-value r" id="channel-r">0</div>
        </div>
        <div class="hex-rgba-channel">
          <div class="hex-rgba-channel-label">G</div>
          <div class="hex-rgba-channel-value g" id="channel-g">0</div>
        </div>
        <div class="hex-rgba-channel">
          <div class="hex-rgba-channel-label">B</div>
          <div class="hex-rgba-channel-value b" id="channel-b">0</div>
        </div>
        <div class="hex-rgba-channel">
          <div class="hex-rgba-channel-label">A</div>
          <div class="hex-rgba-channel-value a" id="channel-a">1</div>
        </div>
      </div>

      <!-- Color Preview Swatch (checkerboard for transparency) -->
      <div class="hex-rgba-swatch" id="swatch-container">
        <div class="hex-rgba-swatch-fill" id="color-preview"></div>
        <div class="hex-rgba-swatch-empty" id="swatch-placeholder">Preview</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="hex-rgba-toolbar">
      <div class="hex-rgba-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="hex-rgba-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var hexInput          = document.getElementById('hex-input');
      var opacitySlider     = document.getElementById('opacity-slider');
      var opacityDisplay    = document.getElementById('opacity-display');
      var rgbaOutput        = document.getElementById('rgba-output');
      var outputCard        = document.getElementById('output-card');
      var colorPreview      = document.getElementById('color-preview');
      var swatchPlaceholder = document.getElementById('swatch-placeholder');
      var rgbaChannels      = document.getElementById('rgba-channels');
      var channelR          = document.getElementById('channel-r');
      var channelG          = document.getElementById('channel-g');
      var channelB          = document.getElementById('channel-b');
      var channelA          = document.getElementById('channel-a');
      var btnConvert        = document.getElementById('btn-convert');
      var btnRandom         = document.getElementById('btn-random');
      var btnClear          = document.getElementById('btn-clear');
      var btnCopy           = document.getElementById('btn-copy');
      var statusMessage     = document.getElementById('status-message');
      var statusDot         = document.getElementById('status-dot');
      var statusText        = document.getElementById('status-text');

      function showResult(text, type, r, g, b, a) {
        rgbaOutput.textContent = text;
        rgbaOutput.className = 'tool-output-value';
        if (type === 'empty') rgbaOutput.className += ' empty';
        else if (type === 'error') rgbaOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          colorPreview.style.backgroundColor = 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')';
          swatchPlaceholder.style.display = 'none';
          channelR.textContent = r;
          channelG.textContent = g;
          channelB.textContent = b;
          channelA.textContent = a;
          rgbaChannels.style.display = 'flex';
        } else {
          outputCard.classList.remove('has-result');
          colorPreview.style.backgroundColor = 'transparent';
          swatchPlaceholder.style.display = '';
          rgbaChannels.style.display = 'none';
        }
      }

      function convert() {
        var input = hexInput.value.trim().replace(/^#/, '').replace(/\s/g, '');
        if (input.length === 3) {
          input = input[0] + input[0] + input[1] + input[1] + input[2] + input[2];
        }
        if (input.length !== 6 || !/^[0-9A-Fa-f]{6}$/.test(input)) {
          showResult('Invalid hex color', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid hex color — use format #RRGGBB');
          return;
        }
        var r = parseInt(input.substring(0, 2), 16);
        var g = parseInt(input.substring(2, 4), 16);
        var b = parseInt(input.substring(4, 6), 16);
        var opacity = parseInt(opacitySlider.value, 10);
        var alpha = opacity / 100;
        showResult('rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')', 'valid', r, g, b, alpha);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
      }

      btnConvert.onclick = convert;

      btnRandom.onclick = function () {
        var hex = Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0').toUpperCase();
        hexInput.value = '#' + hex;
        opacitySlider.value = Math.floor(Math.random() * 101);
        opacityDisplay.textContent = opacitySlider.value + '%';
        convert();
      };

      btnClear.addEventListener('click', function () {
        hexInput.value = '';
        opacitySlider.value = 100;
        opacityDisplay.textContent = '100%';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = rgbaOutput.textContent;
        if (text && !rgbaOutput.classList.contains('empty') && !rgbaOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      hexInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Opacity slider live update
      opacitySlider.addEventListener('input', function () {
        opacityDisplay.textContent = opacitySlider.value + '%';
        convert();
      });

      // Live conversion on hex input
      hexInput.addEventListener('input', function () {
        var input = hexInput.value.trim().replace(/^#/, '').replace(/\s/g, '');
        if (input.length === 3) {
          input = input[0] + input[0] + input[1] + input[1] + input[2] + input[2];
        }
        if (!input) {
          showResult('Result will appear here', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        if (input.length === 6 && /^[0-9A-Fa-f]{6}$/.test(input)) {
          var r = parseInt(input.substring(0, 2), 16);
          var g = parseInt(input.substring(2, 4), 16);
          var b = parseInt(input.substring(4, 6), 16);
          var opacity = parseInt(opacitySlider.value, 10);
          var alpha = opacity / 100;
          showResult('rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')', 'valid', r, g, b, alpha);
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
        }
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
