---
lang: "pt"
toolId: "exif-remover"
category: "image-utilities"
activeTool: "exif-remover"
permalink: "/pt/exif-remover.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <div class="dropzone-area" id="dropzone">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
    <p>{{ toolData.dropzoneMessage }}</p>
    <span class="dropzone-hint">{{ toolData.dropzoneHint }}</span>
    <input type="file" id="file-input" accept="image/*" multiple hidden>
  </div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="btn btn-ghost" id="btn-clear" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        {{ t.ui.clearQueue }}
      </button>
    </div>
    <div class="toolbar-right">
      <button class="btn btn-primary" id="btn-download-all" type="button" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        {{ t.ui.downloadAll }}
      </button>
    </div>
  </div>

  <div id="file-list" class="file-list"></div>

  <div class="status-bar">
    <div class="status-message idle" id="status-message">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
    <div class="status-meta">
      <span id="file-count">0 {{ t.ui.files }}</span>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script>
    (function () {
      'use strict';

      var dropzone = document.getElementById('dropzone');
      var fileInput = document.getElementById('file-input');
      var fileList = document.getElementById('file-list');
      var btnClear = document.getElementById('btn-clear');
      var btnDownloadAll = document.getElementById('btn-download-all');
      var statusMessage = document.getElementById('status-message');
      var statusDot = document.getElementById('status-dot');
      var statusText = document.getElementById('status-text');
      var fileCount = document.getElementById('file-count');

      var results = [];
      var MAX_FILES = 20;
      var MAX_SIZE = 10 * 1024 * 1024;

      dropzone.addEventListener('click', function () { fileInput.click(); });
      dropzone.addEventListener('dragover', function (e) { e.preventDefault(); dropzone.classList.add('dragover'); });
      dropzone.addEventListener('dragleave', function () { dropzone.classList.remove('dragover'); });
      dropzone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        handleFiles(e.dataTransfer.files);
      });
      fileInput.addEventListener('change', function () { handleFiles(this.files); this.value = ''; });

      function handleFiles(files) {
        var remaining = MAX_FILES - results.length;
        var toProcess = Array.from(files).slice(0, remaining);
        toProcess.forEach(function (file) {
          if (file.size > MAX_SIZE) return;
          processFile(file);
        });
      }

      function processFile(file) {
        var id = 'file-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5);
        var item = document.createElement('div');
        item.className = 'file-item';
        item.id = id;
        item.innerHTML = '<span class="file-name">' + file.name + '</span><span class="file-status">Processing...</span>';
        fileList.appendChild(item);

        var reader = new FileReader();
        reader.onload = function (e) {
          var img = new Image();
          img.onload = function () {
            var canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);
            var isPng = file.type === 'image/png';
            canvas.toBlob(function (blob) {
              var originalSize = file.size;
              var compressedSize = blob.size;
              var rate = ((compressedSize - originalSize) / originalSize * 100).toFixed(1);
              var url = URL.createObjectURL(blob);
              var name = file.name.replace(/\.[^.]+$/, '') + '-no-exif' + (isPng ? '.png' : '.jpg');

              results.push({ name: name, blob: blob, url: url });

              var statusEl = item.querySelector('.file-status');
              statusEl.innerHTML = '<span class="compression-rate">' + rate + '%</span> <a href="' + url + '" download="' + name + '" class="btn btn-ghost btn-sm">{{ t.ui.download }}</a>';

              fileCount.textContent = results.length + ' files';
              btnDownloadAll.disabled = false;
              ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', results.length + ' {{ t.ui.filesProcessed }}');
            }, isPng ? 'image/png' : 'image/jpeg', isPng ? undefined : 0.92);
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      }

      btnClear.addEventListener('click', function () {
        results.forEach(function (r) { URL.revokeObjectURL(r.url); });
        results = [];
        fileList.innerHTML = '';
        btnDownloadAll.disabled = true;
        fileCount.textContent = '0 files';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnDownloadAll.addEventListener('click', function () {
        if (results.length === 0) return;
        if (results.length === 1) {
          var a = document.createElement('a');
          a.href = results[0].url;
          a.download = results[0].name;
          a.click();
          return;
        }
        var zip = new JSZip();
        var pending = results.length;
        results.forEach(function (r) {
          zip.file(r.name, r.blob);
        });
        zip.generateAsync({ type: 'blob' }).then(function (content) {
          var url = URL.createObjectURL(content);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'images-no-exif.zip';
          a.click();
          URL.revokeObjectURL(url);
        });
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
