---
lang: "fr"
toolId: "hex-to-binary"
category: "number-conversion"
activeTool: "hex-to-binary"
permalink: "/fr/hex-to-binary.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <label class="section-label" for="hex-input">{{ t.ui.hexNumber }}</label>
  <div class="input-row">
    <input type="text" class="text-input" id="hex-input" placeholder="{{ toolData.inputPlaceholder }}" spellcheck="false" autocomplete="off">
  </div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="btn btn-primary" id="btn-convert" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        {{ t.ui.convert }}
      </button>
      <button class="btn btn-ghost" id="btn-swap" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
        {{ t.ui.swap }}
      </button>
      <button class="btn btn-ghost" id="btn-clear" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        {{ t.ui.clear }}
      </button>
    </div>
    <div class="toolbar-right">
      <button class="btn btn-ghost" id="btn-copy" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        {{ t.ui.copy }}
      </button>
    </div>
  </div>

  <div style="margin-top: 24px;">
    <label class="section-label" for="binary-output">{{ t.ui.binaryNumber }}</label>
    <div class="input-row">
      <input type="text" class="text-input output-field" id="binary-output" readonly placeholder="{{ t.ui.binaryResult }}">
    </div>
  </div>

  <div style="margin-top: 16px;">
    <label class="section-label" for="decimal-output">{{ t.ui.decimalNumber }}</label>
    <div class="input-row">
      <input type="text" class="text-input output-field" id="decimal-output" readonly placeholder="{{ t.ui.decimalResult }}">
    </div>
  </div>
  <div style="margin-top: 16px;">
    <label class="section-label" for="octal-output">{{ t.ui.octalNumber }}</label>
    <div class="input-row">
      <input type="text" class="text-input output-field" id="octal-output" readonly placeholder="{{ t.ui.octalResult }}">
    </div>
  </div>
  <div class="status-bar">
    <div class="status-message idle" id="status-message">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
  'use strict';
  var input = document.getElementById('hex-input');
  var output = document.getElementById('binary-output');
  var btnConvert = document.getElementById('btn-convert');
  var btnSwap = document.getElementById('btn-swap');
  var btnClear = document.getElementById('btn-clear');
  var btnCopy = document.getElementById('btn-copy');
  var statusMessage = document.getElementById('status-message');
  var statusDot = document.getElementById('status-dot');
  var statusText = document.getElementById('status-text');

  function convert() {
    var val = input.value.replace(/\s/g, '');
    if (!val) return;
    try {
      var result = new BigNumber(val, 16);
      output.value = result.toString(2);
      document.getElementById('decimal-output').value = result.toString(10);
      document.getElementById('octal-output').value = result.toString(8);
      ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
    } catch (e) {
      ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ t.ui.invalidInput }}');
    }
  }
  btnConvert.onclick = convert;
  btnSwap.onclick = function () { window.location.href = '/fr/binary-to-hex'; };
  btnClear.onclick = function () {
    input.value = ''; output.value = '';
    document.getElementById('decimal-output').value = '';
    document.getElementById('octal-output').value = '';
    ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
  };
  btnCopy.onclick = function () { ToolCommon.copyOutput(output, btnCopy); };
  input.addEventListener('keydown', function (e) { if (e.key === 'Enter') convert(); });
  ToolCommon.initExampleCopy();
  ToolCommon.initKeyboardShortcut(btnConvert);
})();
  </script>
{% endblock %}