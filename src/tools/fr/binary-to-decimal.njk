---
lang: "fr"
toolId: "binary-to-decimal"
category: "number-conversion"
activeTool: "binary-to-decimal"
permalink: "/fr/binary-to-decimal.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}

  <div class="nc-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">{{ t.ui.binaryNumber }}</div>
      <input type="text" class="tool-input-field" id="binary-input" placeholder="{{ toolData.inputPlaceholder }}" spellcheck="false" autocomplete="off" autofocus>
      <div class="tool-hint">Valid: <code>0</code>, <code>1</code> only</div>
    </div>

    <!-- Arrow -->
    <div class="nc-arrow">
      <div class="nc-arrow-icon" id="btn-convert" title="{{ t.ui.convert }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Primary Output Card -->
    <div class="tool-output-card" style="--tool-accent: var(--accent)" id="output-card">
      <div class="tool-output-label">
        <span>{{ t.ui.decimalNumber }}</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="{{ t.ui.copy }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          {{ t.ui.copy }}
        </button>
      </div>
      <div class="tool-output-value empty" id="decimal-output">{{ t.ui["none"] }}</div>
    </div>

    <!-- Secondary Results -->
    <div class="nc-secondary-grid">
      <div class="nc-secondary-card" id="hex-card">
        <div class="nc-secondary-label">{{ t.ui.hexNumber }}</div>
        <div class="nc-secondary-value empty" id="hex-output">&mdash;</div>
      </div>
      <div class="nc-secondary-card" id="octal-card">
        <div class="nc-secondary-label">{{ t.ui.octalNumber }}</div>
        <div class="nc-secondary-value empty" id="octal-output">&mdash;</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="nc-toolbar">
      <div class="nc-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          {{ t.ui.clear }}
        </button>
      </div>
      <div class="nc-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="nc-ref">
      <div class="nc-ref-title">{{ t.ui.quickReference }}</div>
      <div class="nc-ref-grid">
        <div class="nc-ref-item"><span class="bin">0</span><span class="arrow">&rarr;</span><span class="dec">0</span></div>
        <div class="nc-ref-item"><span class="bin">1</span><span class="arrow">&rarr;</span><span class="dec">1</span></div>
        <div class="nc-ref-item"><span class="bin">10</span><span class="arrow">&rarr;</span><span class="dec">2</span></div>
        <div class="nc-ref-item"><span class="bin">11</span><span class="arrow">&rarr;</span><span class="dec">3</span></div>
        <div class="nc-ref-item"><span class="bin">100</span><span class="arrow">&rarr;</span><span class="dec">4</span></div>
        <div class="nc-ref-item"><span class="bin">101</span><span class="arrow">&rarr;</span><span class="dec">5</span></div>
        <div class="nc-ref-item"><span class="bin">110</span><span class="arrow">&rarr;</span><span class="dec">6</span></div>
        <div class="nc-ref-item"><span class="bin">111</span><span class="arrow">&rarr;</span><span class="dec">7</span></div>
        <div class="nc-ref-item"><span class="bin">1000</span><span class="arrow">&rarr;</span><span class="dec">8</span></div>
        <div class="nc-ref-item"><span class="bin">1111</span><span class="arrow">&rarr;</span><span class="dec">15</span></div>
        <div class="nc-ref-item"><span class="bin">10000</span><span class="arrow">&rarr;</span><span class="dec">16</span></div>
        <div class="nc-ref-item"><span class="bin">11111111</span><span class="arrow">&rarr;</span><span class="dec">255</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var binaryInput   = document.getElementById('binary-input');
      var decimalOutput = document.getElementById('decimal-output');
      var hexOutput     = document.getElementById('hex-output');
      var octalOutput   = document.getElementById('octal-output');
      var outputCard    = document.getElementById('output-card');
      var hexCard       = document.getElementById('hex-card');
      var octalCard     = document.getElementById('octal-card');
      var btnConvert    = document.getElementById('btn-convert');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      function showPrimary(text, type) {
        decimalOutput.textContent = text;
        decimalOutput.className = 'tool-output-value';
        if (type === 'empty') decimalOutput.className += ' empty';
        else if (type === 'error') decimalOutput.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      function showSecondary(el, card, text, type) {
        el.textContent = text;
        el.className = 'nc-secondary-value';
        if (type === 'empty') el.className += ' empty';
        if (type === 'valid') card.classList.add('has-result');
        else card.classList.remove('has-result');
      }

      function convert() {
        var input = binaryInput.value.replace(/\s/g, '');
        if (!input) {
          showPrimary('{{ t.ui["none"] }}', 'empty');
          showSecondary(hexOutput, hexCard, '—', 'empty');
          showSecondary(octalOutput, octalCard, '—', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        try {
          var result = new BigNumber(input, 2);
          showPrimary(result.toString(10), 'valid');
          showSecondary(hexOutput, hexCard, result.toString(16).toUpperCase(), 'valid');
          showSecondary(octalOutput, octalCard, result.toString(8), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', '{{ t.ui.converted }}');
        } catch (e) {
          showPrimary('{{ t.ui.invalidBinaryInput }}', 'error');
          showSecondary(hexOutput, hexCard, '—', 'empty');
          showSecondary(octalOutput, octalCard, '—', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ t.ui.invalidBinaryInput }}');
        }
      }

      btnConvert.onclick = convert;

      btnClear.addEventListener('click', function () {
        binaryInput.value = '';
        showPrimary('{{ t.ui["none"] }}', 'empty');
        showSecondary(hexOutput, hexCard, '—', 'empty');
        showSecondary(octalOutput, octalCard, '—', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = decimalOutput.textContent;
        if (text && !decimalOutput.classList.contains('empty') && !decimalOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> {{ t.ui.copied }}';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      binaryInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      binaryInput.addEventListener('input', convert);

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
