---
lang: "kr"
toolId: "text-editor"
category: "string-text-utilities"
activeTool: "text-editor"
permalink: "/kr/text-editor.html"
---

{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.css">
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/mode/xml/xml.min.js"></script>
{% endblock %}

{% block tool_content %}

  <div class="dual-pane">
    <div class="pane-card pane-card--input">
      <div class="pane-label"><span><span class="pane-label-dot pane-label-dot--accent"></span>{{ t.ui.input }}</span></div>
      <textarea id="code1" placeholder="{{ toolData.inputPlaceholder }}" aria-label="{{ t.ui.input }}"></textarea>
    </div>
    <div class="pane-toolbar">
      <div class="pane-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>{{ t.ui.clear }}</button>
      </div>
      <div class="pane-toolbar-right">
        <button class="btn btn-ghost" id="btn-copy" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>{{ t.ui.copy }}</button>
        <button class="btn btn-primary" id="btn-download" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>{{ t.ui.download }}</button>
      </div>
    </div>
    <div class="status-bar-dual">
      <div class="status-message idle" id="status-message"><span class="status-dot" id="status-dot" style="display:none;"></span><span id="status-text"></span></div>
      <div class="status-meta-dual"><span id="char-count">0 {{ t.ui.characters }}</span><span id="line-count">0 {{ t.ui.lines }}</span></div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}<p>{{ para | safe }}</p>{% endfor %}
  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">{% for step in toolData.steps %}<li>{{ step | safe }}</li>{% endfor %}</ol>
  <h3>{{ toolData.features }}</h3>
  <ul class="steps-list">{% for feature in toolData.featuresList %}<li>{{ feature | safe }}</li>{% endfor %}</ul>
  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';
      var editor = CodeMirror.fromTextArea(document.getElementById('code1'), { lineNumbers: true, lineWrapping: true });
      editor.getWrapperElement().setAttribute('aria-label', '{{ t.ui.input }}');
      var btnClear = document.getElementById('btn-clear');
      var btnCopy = document.getElementById('btn-copy');
      var btnDownload = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot = document.getElementById('status-dot');
      var statusText = document.getElementById('status-text');
      var charCount = document.getElementById('char-count');
      var lineCount = document.getElementById('line-count');
      function updateCounts() {
        var text = editor.getValue();
        charCount.textContent = ToolCommon.pluralise(text.length, '{{ t.ui.character }}', '{{ t.ui.characters }}');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), '{{ t.ui.line }}', '{{ t.ui.lines }}');
      }
      editor.on('change', updateCounts);
      btnClear.addEventListener('click', function () {
        editor.setValue('');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        charCount.textContent = '0 {{ t.ui.characters }}';
        lineCount.textContent = '0 {{ t.ui.lines }}';
        editor.focus();
      });
      btnCopy.addEventListener('click', function () {
        var text = editor.getValue();
        if (text) {
          ToolCommon.copyText(text).then(function (copied) {
            if (!copied) return;
            btnCopy.textContent = '{{ t.ui.copied }}';
            setTimeout(function () { btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> {{ t.ui.copy }}'; }, 1500);
          });
        }
      });
      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput({ value: editor.getValue() }, 'text-editor-output.txt');
      });
      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnDownload);
    })();
  </script>
{% endblock %}
