---
lang: "kr"
toolId: "roman-numerals-to-numbers"
category: "number-conversion"
activeTool: "roman-numerals-to-numbers"
permalink: "/kr/roman-numerals-to-numbers.html"
---

{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  <style>
    .roman-converter {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .roman-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .roman-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .roman-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--secondary);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(45, 106, 79, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .roman-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(45, 106, 79, 0.4);
    }
    .roman-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .roman-toolbar-left,
    .roman-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .roman-ref {
      margin-top: 24px;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
    }
    .roman-ref-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .roman-ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
      gap: 6px;
    }
    .roman-ref-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      padding: 4px 0;
    }
    .roman-ref-item .sym {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      color: var(--secondary);
      min-width: 32px;
    }
    .roman-ref-item .arrow {
      color: var(--text-muted);
      font-size: 11px;
    }
    .roman-ref-item .num {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 500;
      color: var(--text-secondary);
    }

    /* Gradient accent bar override */
    .tool-input-card::before {
      background: linear-gradient(90deg, var(--secondary), var(--accent));
    }
</style>

  <div class="roman-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">{{ t.ui.romanNumeral }}</div>
      <input type="text" class="tool-input-field" style="--tool-font: 'Fraunces', serif; --tool-font-size: 36px; --tool-font-size-mobile: 28px; --tool-accent: var(--accent); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;" id="roman-input" placeholder="{{ toolData.inputPlaceholder }}" spellcheck="false" autocomplete="off" autofocus>
      <div class="tool-hint">Valid symbols: <code>I</code> <code>V</code> <code>X</code> <code>L</code> <code>C</code> <code>D</code> <code>M</code></div>
    </div>

    <!-- Arrow -->
    <div class="roman-arrow">
      <div class="roman-arrow-icon" id="btn-convert" title="{{ t.ui.convert }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" style="--tool-accent: var(--accent)" id="output-card">
      <div class="tool-output-label">
        <span>{{ t.ui.number }}</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="{{ t.ui.copy }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          {{ t.ui.copy }}
        </button>
      </div>
      <div class="tool-output-value empty" style="--tool-output-font-size: 48px; --tool-output-font-size-mobile: 36px" id="number-output">{{ toolData.outputPlaceholder }}</div>
    </div>

    <!-- Toolbar -->
    <div class="roman-toolbar">
      <div class="roman-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          {{ t.ui.clear }}
        </button>
      </div>
      <div class="roman-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="roman-ref">
      <div class="roman-ref-title">{{ t.ui.quickReference }}</div>
      <div class="roman-ref-grid">
        <div class="roman-ref-item"><span class="sym">I</span><span class="arrow">&rarr;</span><span class="num">1</span></div>
        <div class="roman-ref-item"><span class="sym">V</span><span class="arrow">&rarr;</span><span class="num">5</span></div>
        <div class="roman-ref-item"><span class="sym">X</span><span class="arrow">&rarr;</span><span class="num">10</span></div>
        <div class="roman-ref-item"><span class="sym">L</span><span class="arrow">&rarr;</span><span class="num">50</span></div>
        <div class="roman-ref-item"><span class="sym">C</span><span class="arrow">&rarr;</span><span class="num">100</span></div>
        <div class="roman-ref-item"><span class="sym">D</span><span class="arrow">&rarr;</span><span class="num">500</span></div>
        <div class="roman-ref-item"><span class="sym">M</span><span class="arrow">&rarr;</span><span class="num">1000</span></div>
        <div class="roman-ref-item"><span class="sym">IV</span><span class="arrow">&rarr;</span><span class="num">4</span></div>
        <div class="roman-ref-item"><span class="sym">IX</span><span class="arrow">&rarr;</span><span class="num">9</span></div>
        <div class="roman-ref-item"><span class="sym">XL</span><span class="arrow">&rarr;</span><span class="num">40</span></div>
        <div class="roman-ref-item"><span class="sym">XC</span><span class="arrow">&rarr;</span><span class="num">90</span></div>
        <div class="roman-ref-item"><span class="sym">CD</span><span class="arrow">&rarr;</span><span class="num">400</span></div>
        <div class="roman-ref-item"><span class="sym">CM</span><span class="arrow">&rarr;</span><span class="num">900</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var romanInput   = document.getElementById('roman-input');
      var numberOutput = document.getElementById('number-output');
      var outputCard   = document.getElementById('output-card');
      var btnConvert   = document.getElementById('btn-convert');
      var btnClear     = document.getElementById('btn-clear');
      var btnCopy      = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      var ROMAN_VALUES = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };

      function romanToInt(str) {
        str = str.toUpperCase().trim();
        if (!str || !/^[IVXLCDM]+$/.test(str)) return null;
        var result = 0;
        for (var i = 0; i < str.length; i++) {
          var current = ROMAN_VALUES[str[i]];
          var next = (i + 1 < str.length) ? ROMAN_VALUES[str[i + 1]] : 0;
          if (current < next) result -= current;
          else result += current;
        }
        return result > 0 ? result : null;
      }

      function showResult(text, type) {
        numberOutput.textContent = text;
        numberOutput.className = 'tool-output-value';
        if (type === 'empty') numberOutput.className += ' empty';
        else if (type === 'error') numberOutput.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      btnConvert.onclick = function () {
        var input = romanInput.value.trim();
        if (!input) return;
        var result = romanToInt(input);
        if (result === null) {
          showResult('{{ t.ui.invalidRomanNumeral }}', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Use only I, V, X, L, C, D, M');
          return;
        }
        showResult(result.toString(), 'valid');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
      };

      btnClear.addEventListener('click', function () {
        romanInput.value = '';
        showResult('{{ toolData.outputPlaceholder }}', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = numberOutput.textContent;
        if (text && !numberOutput.classList.contains('empty') && !numberOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> {{ t.ui.copied }}';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      romanInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      romanInput.addEventListener('input', function () {
        var input = romanInput.value.trim();
        if (!input) {
          showResult('{{ toolData.outputPlaceholder }}', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        var result = romanToInt(input);
        if (result === null) {
          showResult('{{ t.ui.invalidRomanNumeral }}', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Use only I, V, X, L, C, D, M');
          return;
        }
        showResult(result.toString(), 'valid');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
