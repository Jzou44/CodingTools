---
lang: "kr"
toolId: "fraction-to-decimal"
category: "number-conversion"
activeTool: "fraction-to-decimal"
permalink: "/kr/fraction-to-decimal.html"
---

{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}

  <div class="frac-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">{{ t.ui.fraction }}</div>
      <div class="frac-visual">
        <input type="text" class="frac-integer-field" id="integer-input" placeholder="0" spellcheck="false" autocomplete="off" autofocus>
        <div class="frac-separator-dot">&middot;</div>
        <div class="frac-stack">
          <div class="frac-num-row">
            <input type="text" id="numerator-input" placeholder="1" spellcheck="false" autocomplete="off">
          </div>
          <div class="frac-den-row">
            <input type="text" id="denominator-input" placeholder="4" spellcheck="false" autocomplete="off">
          </div>
        </div>
      </div>
      <div class="frac-input-hint">{{ t.ui.example }}: <code>2</code> &middot; <code>3</code>&frasl;<code>4</code> = 2.75</div>
    </div>

    <!-- Arrow -->
    <div class="frac-arrow">
      <div class="frac-arrow-icon" id="btn-convert" title="{{ t.ui.convert }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" style="--tool-accent: var(--accent)" id="output-card">
      <div class="tool-output-label">
        <span>{{ t.ui.decimalResult }}</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="{{ t.ui.copyToClipboard }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          {{ t.ui.copy }}
        </button>
      </div>
      <div class="frac-output-value empty" id="decimal-output">{{ toolData.resultPlaceholder }}</div>
    </div>

    <!-- Toolbar -->
    <div class="frac-toolbar">
      <div class="frac-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          {{ t.ui.clear }}
        </button>
      </div>
      <div class="frac-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="frac-ref">
      <div class="frac-ref-title">{{ t.ui.quickReference }}</div>
      <div class="frac-ref-grid">
        <div class="frac-ref-item"><span class="frac">1/2</span><span class="eq">=</span><span class="dec">0.5</span></div>
        <div class="frac-ref-item"><span class="frac">1/3</span><span class="eq">=</span><span class="dec">0.333&hellip;</span></div>
        <div class="frac-ref-item"><span class="frac">2/3</span><span class="eq">=</span><span class="dec">0.666&hellip;</span></div>
        <div class="frac-ref-item"><span class="frac">1/4</span><span class="eq">=</span><span class="dec">0.25</span></div>
        <div class="frac-ref-item"><span class="frac">3/4</span><span class="eq">=</span><span class="dec">0.75</span></div>
        <div class="frac-ref-item"><span class="frac">1/5</span><span class="eq">=</span><span class="dec">0.2</span></div>
        <div class="frac-ref-item"><span class="frac">1/6</span><span class="eq">=</span><span class="dec">0.166&hellip;</span></div>
        <div class="frac-ref-item"><span class="frac">1/8</span><span class="eq">=</span><span class="dec">0.125</span></div>
        <div class="frac-ref-item"><span class="frac">3/8</span><span class="eq">=</span><span class="dec">0.375</span></div>
        <div class="frac-ref-item"><span class="frac">1/10</span><span class="eq">=</span><span class="dec">0.1</span></div>
        <div class="frac-ref-item"><span class="frac">1/16</span><span class="eq">=</span><span class="dec">0.0625</span></div>
        <div class="frac-ref-item"><span class="frac">1/100</span><span class="eq">=</span><span class="dec">0.01</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var integerInput     = document.getElementById('integer-input');
      var numeratorInput   = document.getElementById('numerator-input');
      var denominatorInput = document.getElementById('denominator-input');
      var decimalOutput    = document.getElementById('decimal-output');
      var outputCard       = document.getElementById('output-card');
      var btnConvert       = document.getElementById('btn-convert');
      var btnClear         = document.getElementById('btn-clear');
      var btnCopy          = document.getElementById('btn-copy');
      var statusMessage    = document.getElementById('status-message');
      var statusDot        = document.getElementById('status-dot');
      var statusText       = document.getElementById('status-text');

      function showResult(text, type) {
        decimalOutput.textContent = text;
        decimalOutput.className = 'frac-output-value';
        if (type === 'empty') decimalOutput.className += ' empty';
        else if (type === 'error') decimalOutput.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      function doConvert() {
        var denStr = denominatorInput.value.trim();
        var numStr = numeratorInput.value.trim();
        if (!denStr || !numStr) return;
        try {
          var denominator = new BigNumber(denStr);
          var numerator   = new BigNumber(numStr);
          var integerVal  = new BigNumber(integerInput.value.trim() || '0');
          if (denominator.isZero()) {
            showResult('{{ t.ui.denominatorCannotBeZero }}', 'error');
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ t.ui.denominatorCannotBeZero }}');
            return;
          }
          var result = integerVal.plus(numerator.dividedBy(denominator));
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', '{{ t.ui.convertedSuccessfully }}');
        } catch (e) {
          showResult('{{ t.ui.invalidInput }}', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ t.ui.invalidInput }}');
        }
      }

      btnConvert.onclick = doConvert;

      btnClear.addEventListener('click', function () {
        integerInput.value     = '';
        numeratorInput.value   = '';
        denominatorInput.value = '';
        showResult('{{ toolData.resultPlaceholder }}', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = decimalOutput.textContent;
        if (text && !decimalOutput.classList.contains('empty') && !decimalOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> {{ t.ui.copied }}';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      // Live conversion on input
      var inputs = [integerInput, numeratorInput, denominatorInput];
      inputs.forEach(function (el) {
        el.addEventListener('input', function () {
          var denStr = denominatorInput.value.trim();
          var numStr = numeratorInput.value.trim();
          if (!denStr || !numStr) {
            showResult('{{ toolData.resultPlaceholder }}', 'empty');
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
            return;
          }
          doConvert();
        });
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') doConvert();
        });
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
