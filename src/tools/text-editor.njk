---
category: "string-text-utilities"
activeTool: "text-editor"
permalink: "/text-editor.html"
---

{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.css">
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/mode/xml/xml.min.js"></script>
{% endblock %}

{% block tool_content %}
  <style>
    .dual-pane { display: flex; flex-direction: column; gap: 0; }

    .pane-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }
    .pane-card--input { border-left: 4px solid var(--accent); }
    .pane-card--output { border-left: 4px solid var(--secondary); }

    .pane-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .pane-label-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }
    .pane-label-dot--accent { background: var(--accent); }
    .pane-label-dot--secondary { background: var(--secondary); }

    .pane-card .CodeMirror {
      height: 300px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      line-height: 1.6;
      background: #fff;
      border: 1px solid #e8e4dc;
      border-radius: var(--radius-sm);
      padding: 4px 0;
    }
    .pane-card .CodeMirror-scroll { padding: 8px 12px; }
    .pane-card .CodeMirror-gutters {
      background: #fff;
      border-right: 1px solid var(--border);
    }

    .pane-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      gap: 8px;
      flex-wrap: wrap;
    }
    .pane-toolbar-left,
    .pane-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .status-bar-dual {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 4px 0;
      font-size: 12px;
      color: inherit;
    }
    .status-meta-dual {
      display: flex;
      gap: 16px;
    }
    .status-meta-dual span {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
    }

    @media (max-width: 600px) {
      .pane-card { padding: 16px; }
      .pane-card .CodeMirror { height: 200px; font-size: 13px; }
      .pane-toolbar { gap: 6px; }
    }
  </style>

  <div class="dual-pane">
    <!-- Editor Card -->
    <div class="pane-card pane-card--input">
      <div class="pane-label">
        <span><span class="pane-label-dot pane-label-dot--accent"></span>Editor</span>
      </div>
      <textarea id="code1" placeholder="Start typing or paste text here..." aria-label="Text editor"></textarea>
    </div>

    <!-- Toolbar -->
    <div class="pane-toolbar">
      <div class="pane-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="pane-toolbar-right">
        <button class="btn btn-ghost" id="btn-copy" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
        <button class="btn btn-primary" id="btn-download" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download
        </button>
      </div>
    </div>

    <!-- Status Bar -->
    <div class="status-bar-dual">
      <div class="status-message idle" id="status-message">
        <span class="status-dot" id="status-dot" style="display:none;"></span>
        <span id="status-text"></span>
      </div>
      <div class="status-meta-dual">
        <span id="char-count">0 characters</span>
        <span id="line-count">0 lines</span>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var editor = CodeMirror.fromTextArea(document.getElementById('code1'), { lineNumbers: true, lineWrapping: true });
      editor.getWrapperElement().setAttribute('aria-label', 'Text editor');

      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var charCount     = document.getElementById('char-count');
      var lineCount     = document.getElementById('line-count');

      function updateCounts() {
        var text = editor.getValue();
        charCount.textContent = ToolCommon.pluralise(text.length, 'character');
        lineCount.textContent = ToolCommon.pluralise(ToolCommon.countLines(text), 'line');
      }

      editor.on('change', updateCounts);

      btnClear.addEventListener('click', function () {
        editor.setValue('');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        charCount.textContent = '0 characters';
        lineCount.textContent = '0 lines';
        editor.focus();
      });

      btnCopy.addEventListener('click', function () {
        var text = editor.getValue();
        if (text) {
          ToolCommon.copyText(text).then(function (copied) {
            if (!copied) return;
            btnCopy.textContent = 'Copied!';
            setTimeout(function () { btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copy'; }, 1500);
          });
        }
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput({ value: editor.getValue() }, 'text-editor-output.txt');
      });

      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnDownload);
    })();
  </script>
{% endblock %}
