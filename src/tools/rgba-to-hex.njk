---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <style>
    .rgba-hex-converter {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .tool-input-card::before {
      background: linear-gradient(90deg, #e74c3c, #2ecc71, #3498db, var(--accent));
    }
    .rgba-hex-input-fields {
      display: flex;
      gap: 10px;
    }
    .rgba-hex-field-group {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .rgba-hex-field-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
    }
    .rgba-hex-field-input {
      width: 100%;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 24px;
      font-weight: 500;
      color: var(--text-primary);
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      outline: none;
      padding: 10px 8px;
      text-align: center;
      caret-color: var(--accent);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .rgba-hex-field-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(196, 93, 58, 0.1);
    }
    .rgba-hex-field-input::placeholder {
      color: var(--text-muted);
      font-size: 14px;
      font-weight: 400;
    }
    .rgba-hex-field-input.r-field:focus { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.1); }
    .rgba-hex-field-input.g-field:focus { border-color: #27ae60; box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.1); }
    .rgba-hex-field-input.b-field:focus { border-color: #2980b9; box-shadow: 0 0 0 3px rgba(41, 128, 185, 0.1); }
    .rgba-hex-field-input.a-field:focus { border-color: var(--accent); }
    .rgba-hex-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }

    .rgba-hex-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .rgba-hex-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .rgba-hex-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(196, 93, 58, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .rgba-hex-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(196, 93, 58, 0.4);
    }

    .rgba-hex-output-row {
      display: flex;
      align-items: baseline;
      gap: 16px;
    }
    .rgba-hex-opacity-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      font-weight: 600;
      color: var(--accent);
      background: var(--accent-light);
      padding: 4px 10px;
      border-radius: 6px;
    }

    /* Checkerboard + Color Preview Swatch */
    .rgba-hex-swatch {
      margin-top: 16px;
      border-radius: 12px;
      height: 96px;
      background: repeating-conic-gradient(#e8e0d4 0% 25%, #faf8f0 0% 50%) 50% / 20px 20px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .rgba-hex-swatch-fill {
      position: absolute;
      inset: 0;
      border-radius: 11px;
      transition: background-color 0.2s;
    }
    .rgba-hex-swatch-empty {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      color: var(--text-muted);
      z-index: 1;
      pointer-events: none;
    }

    .rgba-hex-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .rgba-hex-toolbar-left,
    .rgba-hex-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    @media (max-width: 600px) {
      .rgba-hex-field-input { font-size: 20px; padding: 8px 4px; }
      .rgba-hex-swatch { height: 72px; }
      .rgba-hex-input-fields { gap: 6px; }
    }
  </style>

  <div class="rgba-hex-converter">
    <!-- Input Card -->
    <div class="tool-input-card">
      <div class="tool-label">RGBA Color</div>
      <div class="rgba-hex-input-fields">
        <div class="rgba-hex-field-group">
          <span class="rgba-hex-field-label">Red (R)</span>
          <input type="number" class="rgba-hex-field-input r-field" id="r-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off">
        </div>
        <div class="rgba-hex-field-group">
          <span class="rgba-hex-field-label">Green (G)</span>
          <input type="number" class="rgba-hex-field-input g-field" id="g-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off">
        </div>
        <div class="rgba-hex-field-group">
          <span class="rgba-hex-field-label">Blue (B)</span>
          <input type="number" class="rgba-hex-field-input b-field" id="b-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off">
        </div>
        <div class="rgba-hex-field-group">
          <span class="rgba-hex-field-label">Alpha (A)</span>
          <input type="number" class="rgba-hex-field-input a-field" id="a-input" min="0" max="100" value="100" placeholder="0–100" spellcheck="false" autocomplete="off" autofocus>
        </div>
      </div>
      <div class="tool-hint">RGB: <code>0</code>–<code>255</code>, Alpha: <code>0</code>–<code>100%</code></div>
      <div class="rgba-hex-actions">
        <button class="btn btn-secondary" id="btn-random" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          Random
        </button>
      </div>
    </div>

    <!-- Arrow -->
    <div class="rgba-hex-arrow">
      <div class="rgba-hex-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent)">
      <div class="tool-output-label">
        <span>Hex + Opacity</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="rgba-hex-output-row">
        <div class="tool-output-value empty" id="hex-output">Result will appear here</div>
        <span class="rgba-hex-opacity-badge" id="opacity-badge" style="display:none;"><span id="opacity-badge-val">100%</span> opacity</span>
      </div>

      <!-- Color Preview Swatch (checkerboard for transparency) -->
      <div class="rgba-hex-swatch" id="swatch-container">
        <div class="rgba-hex-swatch-fill" id="color-preview"></div>
        <div class="rgba-hex-swatch-empty" id="swatch-placeholder">Preview</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="rgba-hex-toolbar">
      <div class="rgba-hex-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="rgba-hex-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>RGBA to Hex Converter</h2>
  <p>This tool converts RGBA (Red, Green, Blue, Alpha) color values into a hexadecimal color code with an opacity percentage. It helps when you need to represent an RGBA color as a hex code for use in design tools or systems that only accept hex input.</p>
  <p>The conversion runs entirely in your browser. Enter values from 0 to 255 for each RGB channel and 0 to 100% for alpha.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Enter values from 0 to 255 for Red, Green, and Blue.</li>
    <li>Set the Alpha value from 0 to 100%.</li>
    <li>Click <strong>Convert</strong> to see the hex code, opacity, and color preview.</li>
    <li>Click <strong>Random</strong> to generate a random color.</li>
    <li>Use <strong>Copy</strong> to copy the hex value to your clipboard.</li>
  </ol>

  <h3>What is RGBA?</h3>
  <p>RGBA extends the RGB color model with an alpha channel for transparency. The alpha value ranges from 0 (fully transparent) to 1 (fully opaque). When converting to hex, the alpha is preserved as a separate opacity percentage since standard hex codes do not include transparency (8-digit hex codes with alpha are not universally supported).</p>

  <h3>Example</h3>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">RGBA: rgba(255, 87, 51, 1)
Hex: #FF5733, Opacity: 100%

RGBA: rgba(0, 255, 0, 0.5)
Hex: #00FF00, Opacity: 50%

RGBA: rgba(51, 102, 204, 0.75)
Hex: #3366CC, Opacity: 75%</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var rInput           = document.getElementById('r-input');
      var gInput           = document.getElementById('g-input');
      var bInput           = document.getElementById('b-input');
      var aInput           = document.getElementById('a-input');
      var hexOutput        = document.getElementById('hex-output');
      var outputCard       = document.getElementById('output-card');
      var colorPreview     = document.getElementById('color-preview');
      var swatchPlaceholder = document.getElementById('swatch-placeholder');
      var opacityBadge     = document.getElementById('opacity-badge');
      var opacityBadgeVal  = document.getElementById('opacity-badge-val');
      var btnConvert       = document.getElementById('btn-convert');
      var btnRandom        = document.getElementById('btn-random');
      var btnClear         = document.getElementById('btn-clear');
      var btnCopy          = document.getElementById('btn-copy');
      var statusMessage    = document.getElementById('status-message');
      var statusDot        = document.getElementById('status-dot');
      var statusText       = document.getElementById('status-text');

      function toHex(n) {
        var hex = parseInt(n, 10).toString(16).toUpperCase();
        return hex.length === 1 ? '0' + hex : hex;
      }

      function showResult(text, type, r, g, b, alpha, opacityPct) {
        hexOutput.textContent = text;
        hexOutput.className = 'tool-output-value';
        if (type === 'empty') hexOutput.className += ' empty';
        else if (type === 'error') hexOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          colorPreview.style.backgroundColor = 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
          swatchPlaceholder.style.display = 'none';
          opacityBadgeVal.textContent = opacityPct + '%';
          opacityBadge.style.display = '';
        } else {
          outputCard.classList.remove('has-result');
          colorPreview.style.backgroundColor = 'transparent';
          swatchPlaceholder.style.display = '';
          opacityBadge.style.display = 'none';
        }
      }

      function convert() {
        var r = parseInt(rInput.value, 10);
        var g = parseInt(gInput.value, 10);
        var b = parseInt(bInput.value, 10);
        var a = parseInt(aInput.value, 10);
        if (isNaN(r) || isNaN(g) || isNaN(b) || r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) {
          showResult('RGB values must be 0–255', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'RGB values must be between 0 and 255');
          return;
        }
        if (isNaN(a) || a < 0 || a > 100) {
          showResult('Alpha must be 0–100', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Alpha must be between 0 and 100');
          return;
        }
        var hex = '#' + toHex(r) + toHex(g) + toHex(b);
        var alpha = a / 100;
        showResult(hex, 'valid', r, g, b, alpha, a);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
      }

      btnConvert.onclick = convert;

      btnRandom.onclick = function () {
        rInput.value = Math.floor(Math.random() * 256);
        gInput.value = Math.floor(Math.random() * 256);
        bInput.value = Math.floor(Math.random() * 256);
        aInput.value = Math.floor(Math.random() * 101);
        convert();
      };

      btnClear.addEventListener('click', function () {
        rInput.value = '';
        gInput.value = '';
        bInput.value = '';
        aInput.value = '100';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = hexOutput.textContent;
        if (text && !hexOutput.classList.contains('empty') && !hexOutput.classList.contains('error')) {
          var copyText = text + ' (opacity: ' + aInput.value + '%)';
          navigator.clipboard.writeText(copyText).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      [rInput, gInput, bInput, aInput].forEach(function (el) {
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') btnConvert.click();
        });
      });

      // Live conversion on input
      function liveConvert() {
        var r = parseInt(rInput.value, 10);
        var g = parseInt(gInput.value, 10);
        var b = parseInt(bInput.value, 10);
        var a = parseInt(aInput.value, 10);
        if (rInput.value === '' && gInput.value === '' && bInput.value === '') {
          showResult('Result will appear here', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        if (isNaN(r) || isNaN(g) || isNaN(b) || r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) return;
        if (isNaN(a) || a < 0 || a > 100) return;
        var hex = '#' + toHex(r) + toHex(g) + toHex(b);
        var alpha = a / 100;
        showResult(hex, 'valid', r, g, b, alpha, a);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
      }

      rInput.addEventListener('input', liveConvert);
      gInput.addEventListener('input', liveConvert);
      bInput.addEventListener('input', liveConvert);
      aInput.addEventListener('input', liveConvert);

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
