{% endblock %}

{% block description %}
  <h2>Decimal to Fraction Converter</h2>
  <p>This tool converts a decimal number into its fraction equivalent, expressed as an integer part, numerator, and denominator. It is useful when you need to express decimal values as exact fractions for math, engineering, or cooking measurements.</p>
  <p>The conversion runs entirely in your browser. The tool finds the simplest fraction representation by calculating the greatest common divisor (GCD).</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Enter a decimal number in the input field (e.g. <code>2.75</code> or <code>0.333</code>).</li>
    <li>Click <strong>Convert</strong> to see the fraction result.</li>
    <li>The integer, numerator, and denominator are displayed separately.</li>
    <li>Use <strong>Copy</strong> to copy the fraction to your clipboard, or <strong>Clear</strong> to reset.</li>
  </ol>

  <h3>How it works</h3>
  <p>The tool separates the integer part from the decimal part, then converts the decimal part to a fraction. It multiplies the decimal by powers of 10 to eliminate the decimal point, then simplifies by dividing both numerator and denominator by their greatest common divisor (GCD).</p>

  <h3>Example</h3>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">Decimal:     2.75
Fraction:    2 3/4

Decimal:     0.5
Fraction:    1/2

Decimal:     3.125
Fraction:    3 1/8</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var decimalInput     = document.getElementById('decimal-input');
      var resultVisual     = document.getElementById('result-visual');
      var resultText       = document.getElementById('result-text');
      var outputCard       = document.getElementById('output-card');
      var btnConvert       = document.getElementById('btn-convert');
      var btnClear         = document.getElementById('btn-clear');
      var btnCopy          = document.getElementById('btn-copy');
      var statusMessage    = document.getElementById('status-message');
      var statusDot        = document.getElementById('status-dot');
      var statusText       = document.getElementById('status-text');

      // Store the last computed fraction for copy
      var lastFraction = '';

      function gcd(a, b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b) { var t = b; b = a % b; a = t; }
        return a;
      }

      function showEmpty(text) {
        resultVisual.className = 'dec-result-visual empty';
        resultVisual.innerHTML = '<span class="dec-result-empty">' + (text || 'Result will appear here') + '</span>';
        outputCard.classList.remove('has-result');
        lastFraction = '';
      }

      function showError(text) {
        resultVisual.className = 'dec-result-visual error';
        resultVisual.innerHTML = '<span class="dec-result-empty">' + text + '</span>';
        outputCard.classList.remove('has-result');
        lastFraction = '';
      }

      function showFraction(intPart, numPart, denPart) {
        var intDisplay = intPart !== '0' ? intPart : '';
        var html = '';

        if (intDisplay) {
          html += '<span class="dec-res-integer">' + intDisplay + '</span>';
          html += '<span class="dec-res-dot">&middot;</span>';
        }

        html += '<div class="dec-res-stack">';
        html += '<div class="dec-res-num-row"><span>' + numPart + '</span></div>';
        html += '<div class="dec-res-den-row"><span>' + denPart + '</span></div>';
        html += '</div>';

        resultVisual.className = 'dec-result-visual';
        resultVisual.innerHTML = html;
        outputCard.classList.add('has-result');

        lastFraction = (intDisplay ? intDisplay + ' ' : '') + numPart + '/' + denPart;
      }

      function doConvert() {
        var input = decimalInput.value.trim();
        if (!input) return;
        try {
          var num = parseFloat(input);
          if (isNaN(num)) throw new Error('Invalid number');

          var isNegative = num < 0;
          num = Math.abs(num);

          var integerPart = Math.floor(num);
          var decimalPart = num - integerPart;

          if (decimalPart === 0) {
            var intStr = integerPart === 0 ? '0' : '' + integerPart;
            if (isNegative) intStr = '-' + intStr;
            showFraction(intStr, '0', '1');
          } else {
            var decStr = input.replace(/^-/, '').split('.')[1] || '';
            var places = decStr.length;
            var denominator = Math.pow(10, places);
            var numerator = Math.round(decimalPart * denominator);
            var g = gcd(numerator, denominator);
            numerator   = numerator / g;
            denominator = denominator / g;

            var intStr2 = integerPart === 0 ? '0' : '' + integerPart;
            if (isNegative && integerPart === 0 && numerator > 0) intStr2 = '-0';
            else if (isNegative) intStr2 = '-' + intStr2;

            showFraction(intStr2, '' + numerator, '' + denominator);
          }

          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
        } catch (e) {
          showError('Invalid decimal input');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid decimal input');
        }
      }

      btnConvert.onclick = doConvert;

      btnClear.addEventListener('click', function () {
        decimalInput.value = '';
        showEmpty('Result will appear here');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        if (lastFraction) {
          navigator.clipboard.writeText(lastFraction).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      decimalInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') doConvert();
      });

      // Live conversion on input
      decimalInput.addEventListener('input', function () {
        var input = decimalInput.value.trim();
        if (!input) {
          showEmpty('Result will appear here');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        doConvert();
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
