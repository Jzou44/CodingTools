    /* Gradient accent bar override */
    .dec-converter .tool-input-card::before {
      background: linear-gradient(90deg, var(--secondary), #3d8b6a);
    }

    /* Arrow */
    .dec-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .dec-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .dec-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--secondary);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(45, 106, 79, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .dec-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(45, 106, 79, 0.4);
    }

    /* Fraction result visual */
    .dec-result-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 80px;
    }
    .dec-result-visual.empty {
      justify-content: flex-start;
    }
    .dec-result-visual.empty .dec-result-empty {
      font-family: 'DM Sans', sans-serif;
      color: inherit;
      font-size: 18px;
      font-weight: 400;
      font-style: italic;
    }
    .dec-result-visual.error .dec-result-empty {
      font-family: 'DM Sans', sans-serif;
      color: var(--error);
      font-size: 15px;
      font-weight: 500;
      font-style: normal;
    }

    .dec-res-integer {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 42px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: 0.02em;
    }
    .dec-res-dot {
      font-size: 28px;
      color: inherit;
      font-weight: 700;
      user-select: none;
    }
    .dec-res-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .dec-res-num-row {
      padding-bottom: 6px;
      border-bottom: 3px solid var(--secondary);
      text-align: center;
    }
    .dec-res-den-row {
      padding-top: 6px;
      text-align: center;
    }
    .dec-res-num-row span,
    .dec-res-den-row span {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 42px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: 0.02em;
    }

    /* Toolbar */
    .dec-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .dec-toolbar-left,
    .dec-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Quick Reference */
    .dec-ref {
      margin-top: 24px;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
    }
    .dec-ref-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 12px;
    }
    .dec-ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 6px;
    }
    .dec-ref-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      padding: 4px 0;
    }
    .dec-ref-item .dec {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 500;
      color: var(--text-secondary);
      min-width: 40px;
    }
    .dec-ref-item .eq {
      color: inherit;
      font-size: 12px;
    }
    .dec-ref-item .frac {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      color: var(--secondary);
    }

    @media (max-width: 600px) {
      .dec-res-integer, .dec-res-num-row span, .dec-res-den-row span { font-size: 32px; }
      .dec-ref-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
    }
  </style>

  <div class="dec-converter">
