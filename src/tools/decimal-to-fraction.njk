        <div class="dec-ref-item"><span class="dec">0.2</span><span class="eq">=</span><span class="frac">1/5</span></div>
        <div class="dec-ref-item"><span class="dec">0.0625</span><span class="eq">=</span><span class="frac">1/16</span></div>
        <div class="dec-ref-item"><span class="dec">0.01</span><span class="eq">=</span><span class="frac">1/100</span></div>
        <div class="dec-ref-item"><span class="dec">1.5</span><span class="eq">=</span><span class="frac">1 1/2</span></div>
        <div class="dec-ref-item"><span class="dec">2.75</span><span class="eq">=</span><span class="frac">2 3/4</span></div>
        <div class="dec-ref-item"><span class="dec">3.125</span><span class="eq">=</span><span class="frac">3 1/8</span></div>
