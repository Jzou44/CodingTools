      <div class="tool-hint">Examples: <code>2.75</code>, <code>0.333</code>, <code>3.125</code></div>
    </div>

    <!-- Arrow -->
    <div class="dec-arrow">
      <div class="dec-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--secondary)">
      <div class="tool-output-label">
        <span>Fraction Result</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="dec-result-visual empty" id="result-visual">
        <span class="dec-result-empty" id="result-text">Result will appear here</span>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="dec-toolbar">
      <div class="dec-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
