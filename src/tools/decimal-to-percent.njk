---
category: "number-conversion"
activeTool: "decimal-to-percent"
permalink: "/decimal-to-percent.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}

  <div class="dec-pct-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">Decimal</div>
      <input type="text" class="tool-input-field" id="decimal-input" placeholder="Enter decimal value..." spellcheck="false" autocomplete="off" autofocus>
      <div class="tool-hint">Enter a value like <code>0.75</code> or <code>1.5</code></div>
    </div>

    <!-- Arrow -->
    <div class="dec-pct-arrow">
      <div class="dec-pct-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent); --tool-output-font-size: 36px; --tool-output-font-size-mobile: 28px;">
      <div class="tool-output-label">
        <span>Percent</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="dec-pct-output-wrap">
        <div class="tool-output-value empty" id="percent-output">Result will appear here</div>
        <span class="dec-pct-suffix" id="percent-suffix" style="display:none;">%</span>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="dec-pct-toolbar">
      <div class="dec-pct-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="dec-pct-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="dec-pct-ref">
      <div class="dec-pct-ref-title">Quick Reference</div>
      <div class="dec-pct-ref-grid">
        <div class="dec-pct-ref-item"><span class="dec">0.01</span><span class="arrow">&rarr;</span><span class="pct">1%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">0.1</span><span class="arrow">&rarr;</span><span class="pct">10%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">0.25</span><span class="arrow">&rarr;</span><span class="pct">25%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">0.5</span><span class="arrow">&rarr;</span><span class="pct">50%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">0.75</span><span class="arrow">&rarr;</span><span class="pct">75%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">1</span><span class="arrow">&rarr;</span><span class="pct">100%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">1.5</span><span class="arrow">&rarr;</span><span class="pct">150%</span></div>
        <div class="dec-pct-ref-item"><span class="dec">2</span><span class="arrow">&rarr;</span><span class="pct">200%</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var decimalInput  = document.getElementById('decimal-input');
      var percentOutput = document.getElementById('percent-output');
      var percentSuffix = document.getElementById('percent-suffix');
      var outputCard    = document.getElementById('output-card');
      var btnConvert    = document.getElementById('btn-convert');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      function showResult(text, type) {
        percentOutput.textContent = text;
        percentOutput.className = 'tool-output-value';
        if (type === 'empty') percentOutput.className += ' empty';
        else if (type === 'error') percentOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          percentSuffix.style.display = '';
        } else {
          outputCard.classList.remove('has-result');
          percentSuffix.style.display = 'none';
        }
      }

      function convert() {
        var input = decimalInput.value.trim();
        if (!input) return;
        try {
          var result = new BigNumber(input).multipliedBy(100);
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
        } catch (e) {
          showResult('Invalid decimal input', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid decimal input');
        }
      }

      btnConvert.onclick = convert;

      btnClear.addEventListener('click', function () {
        decimalInput.value = '';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = percentOutput.textContent;
        if (text && !percentOutput.classList.contains('empty') && !percentOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text + '%').then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      decimalInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      decimalInput.addEventListener('input', function () {
        var input = decimalInput.value.trim();
        if (!input) {
          showResult('Result will appear here', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        try {
          var result = new BigNumber(input).multipliedBy(100);
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
        } catch (e) {
          showResult('Invalid decimal input', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid input');
        }
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
