{% block description %}
  <h2>Character Count Online</h2>
  <p>This character counter tool counts total characters, characters without spaces, words, lines, and UTF-8 bytes in real time. It also tracks how many characters you have left before hitting the Twitter 280-character limit, making it ideal for social media managers, writers, and developers.</p>
  <p>All counting happens locally in your browser. Your text is never uploaded, stored, or sent to a server, so the tool is fast, private, and free to use without any restrictions.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Paste or type your text into the input editor.</li>
    <li>View live statistics in the panel below the editor. All metrics update instantly as you type.</li>
    <li>Check the <strong>Twitter remaining</strong> counter to see how many characters you have left for a tweet. It turns red when you exceed 280 characters.</li>
    <li>Use <strong>Copy</strong> to copy the text to your clipboard, <strong>Download</strong> to save it as a text file, or <strong>Clear</strong> to reset everything.</li>
  </ol>

  <h3>What is a character counter?</h3>
  <p>A character counter is a tool that analyzes text and reports the number of characters it contains. Unlike a word counter, which groups text by spaces, a character counter measures every individual letter, number, symbol, and whitespace character. This is especially important for platforms with strict character limits, such as Twitter (280 characters), SMS messages (160 characters), and meta descriptions for SEO (around 155 characters).</p>
  <p>This tool also displays the UTF-8 byte count, which is useful for developers working with APIs, databases, or systems that enforce byte-level size limits on text fields.</p>

  <h3>Input notes</h3>
  <p>The tool handles any text input, including Unicode characters such as emojis, accented letters, and CJK characters. Note that multi-byte Unicode characters count as 1 character but may take 2-4 bytes in UTF-8 encoding, which is why the byte count may be higher than the character count.</p>

  <h3>Example</h3>
  <p>Paste a sample text and watch the statistics update live:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">--- Sample Text ---
Hello, World! 🌍

--- Expected Statistics ---
Total Characters: 16
Characters (no spaces): 14
Words: 2
Lines: 2
Bytes (UTF-8): 18
Twitter remaining: 264</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor   = document.getElementById('input-editor');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var charCount     = document.getElementById('char-count');
      var lineCount     = document.getElementById('line-count');
      var inputLineNums = document.getElementById('input-line-numbers');

      var statTotalChars   = document.getElementById('stat-total-chars');
      var statCharsNoSpaces = document.getElementById('stat-chars-nospaces');
      var statWords        = document.getElementById('stat-words');
      var statLines        = document.getElementById('stat-lines');
      var statBytes        = document.getElementById('stat-bytes');
      var statTwitter      = document.getElementById('stat-twitter');

      function countWords(text) {
        var trimmed = text.trim();
        if (!trimmed) return 0;
        return trimmed.split(/\s+/).filter(function (w) { return w.length > 0; }).length;
      }

      function updateStats() {
        var text = inputEditor.value;
        var totalChars = text.length;
        var charsNoSpaces = text.replace(/\s/g, '').length;
        var words = countWords(text);
        var lines = ToolCommon.countLines(text);
        var bytes = new Blob([text]).size;
        var twitterRemaining = 280 - totalChars;

        statTotalChars.textContent = totalChars;
        statCharsNoSpaces.textContent = charsNoSpaces;
        statWords.textContent = words;
        statLines.textContent = lines;
        statBytes.textContent = bytes;

        statTwitter.textContent = twitterRemaining;
        if (twitterRemaining < 0) {
          statTwitter.style.color = '#ef4444';
        } else if (twitterRemaining < 20) {
          statTwitter.style.color = '#f59e0b';
        } else {
          statTwitter.style.color = '';
        }

        charCount.textContent = ToolCommon.pluralise(totalChars, 'character');
        lineCount.textContent = ToolCommon.pluralise(lines, 'line');
        ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      }

      inputEditor.addEventListener('input', function () {
        updateStats();
        if (inputEditor.value) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Statistics updated');
        } else {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        }
      });

      btnClear.addEventListener('click', function () {
        inputEditor.value = '';
        updateStats();
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        inputEditor.focus();
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(inputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(inputEditor, 'character-count-input.txt');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
    })();
  </script>
{% endblock %}
