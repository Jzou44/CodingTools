---
title: "Hex to RGB Converter — Coding.Tools"
description: "Convert hex color codes to RGB values with live color preview. Fast, private, and free to use."
toolTitle: "Hex to RGB"
toolDescription: "Enter a hex color code and convert it to RGB values. See a live color preview and generate random colors."
category: "number-conversion"
categoryName: "Number Conversion"
activeTool: "hex-to-rgb"
permalink: "/hex-to-rgb.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <style>
    .hex-rgb-converter {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .tool-input-card::before {
      background: linear-gradient(90deg, #e74c3c, #f39c12, #2ecc71, #3498db, #9b59b6);
    }
    .hex-rgb-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
    }

    .hex-rgb-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .hex-rgb-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .hex-rgb-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(196, 93, 58, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .hex-rgb-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(196, 93, 58, 0.4);
    }

    /* Color Preview Swatch */
    .hex-rgb-swatch {
      margin-top: 16px;
      border-radius: 12px;
      height: 96px;
      background: repeating-conic-gradient(#e8e0d4 0% 25%, #faf8f0 0% 50%) 50% / 20px 20px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .hex-rgb-swatch-fill {
      position: absolute;
      inset: 0;
      background-color: #cccccc;
      border-radius: 11px;
      transition: background-color 0.2s;
    }
    .hex-rgb-swatch-empty {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      color: var(--text-muted);
      z-index: 1;
      pointer-events: none;
    }

    /* RGB Channel Display */
    .hex-rgb-channels {
      display: flex;
      gap: 12px;
      margin-top: 16px;
    }
    .hex-rgb-channel {
      flex: 1;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
      text-align: center;
    }
    .hex-rgb-channel-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 4px;
    }
    .hex-rgb-channel-value {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 20px;
      font-weight: 600;
      color: var(--text-primary);
    }
    .hex-rgb-channel-value.r { color: #c0392b; }
    .hex-rgb-channel-value.g { color: #27ae60; }
    .hex-rgb-channel-value.b { color: #2980b9; }

    .hex-rgb-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .hex-rgb-toolbar-left,
    .hex-rgb-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    @media (max-width: 600px) {
      .hex-rgb-swatch { height: 72px; }
    }
  </style>

  <div class="hex-rgb-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">Hex Color</div>
      <input type="text" class="tool-input-field" id="hex-input" placeholder="#FF5733" spellcheck="false" autocomplete="off" autofocus>
      <div class="tool-hint">Enter a hex code like <code>#FF5733</code> or <code>#F00</code></div>
      <div class="hex-rgb-actions">
        <button class="btn btn-secondary" id="btn-random" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          Random
        </button>
      </div>
    </div>

    <!-- Arrow -->
    <div class="hex-rgb-arrow">
      <div class="hex-rgb-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent)">
      <div class="tool-output-label">
        <span>RGB Value</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="tool-output-value empty" id="rgb-output" style="--tool-output-font-size: 28px; --tool-output-font-size-mobile: 22px; --tool-accent: var(--accent)">Result will appear here</div>

      <!-- RGB Channels -->
      <div class="hex-rgb-channels" id="rgb-channels" style="display:none;">
        <div class="hex-rgb-channel">
          <div class="hex-rgb-channel-label">Red</div>
          <div class="hex-rgb-channel-value r" id="channel-r">0</div>
        </div>
        <div class="hex-rgb-channel">
          <div class="hex-rgb-channel-label">Green</div>
          <div class="hex-rgb-channel-value g" id="channel-g">0</div>
        </div>
        <div class="hex-rgb-channel">
          <div class="hex-rgb-channel-label">Blue</div>
          <div class="hex-rgb-channel-value b" id="channel-b">0</div>
        </div>
      </div>

      <!-- Color Preview Swatch -->
      <div class="hex-rgb-swatch" id="swatch-container">
        <div class="hex-rgb-swatch-fill" id="color-preview"></div>
        <div class="hex-rgb-swatch-empty" id="swatch-placeholder">Preview</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="hex-rgb-toolbar">
      <div class="hex-rgb-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="hex-rgb-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>Hex to RGB Converter</h2>
  <p>This tool converts hexadecimal color codes into their RGB (Red, Green, Blue) decimal equivalents. It includes a live color preview so you can see exactly what the color looks like. The random color button generates a new color each time.</p>
  <p>The conversion runs entirely in your browser. Enter a hex code with or without the <code>#</code> prefix.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Enter a hex color code in the input field (e.g. <code>#FF5733</code> or <code>FF5733</code>).</li>
    <li>Click <strong>Convert</strong> to see the RGB values and color preview.</li>
    <li>Click <strong>Random</strong> to generate a random color.</li>
    <li>Use <strong>Copy</strong> to copy the RGB value to your clipboard.</li>
  </ol>

  <h3>What is hex color?</h3>
  <p>A hex color code is a 6-digit hexadecimal number that represents the red, green, and blue components of a color. The first two digits are red, the middle two are green, and the last two are blue. For example, <code>#FF0000</code> is pure red (R=255, G=0, B=0).</p>

  <h3>Example</h3>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">Hex: #FF5733
RGB: rgb(255, 87, 51)

Hex: #00FF00
RGB: rgb(0, 255, 0)

Hex: #3366CC
RGB: rgb(51, 102, 204)</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var hexInput      = document.getElementById('hex-input');
      var rgbOutput     = document.getElementById('rgb-output');
      var outputCard    = document.getElementById('output-card');
      var colorPreview  = document.getElementById('color-preview');
      var swatchPlaceholder = document.getElementById('swatch-placeholder');
      var rgbChannels   = document.getElementById('rgb-channels');
      var channelR      = document.getElementById('channel-r');
      var channelG      = document.getElementById('channel-g');
      var channelB      = document.getElementById('channel-b');
      var btnConvert    = document.getElementById('btn-convert');
      var btnRandom     = document.getElementById('btn-random');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      function showResult(text, type, r, g, b) {
        rgbOutput.textContent = text;
        rgbOutput.className = 'tool-output-value';
        if (type === 'empty') rgbOutput.className += ' empty';
        else if (type === 'error') rgbOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          colorPreview.style.backgroundColor = 'rgb(' + r + ',' + g + ',' + b + ')';
          swatchPlaceholder.style.display = 'none';
          channelR.textContent = r;
          channelG.textContent = g;
          channelB.textContent = b;
          rgbChannels.style.display = 'flex';
        } else {
          outputCard.classList.remove('has-result');
          colorPreview.style.backgroundColor = 'transparent';
          swatchPlaceholder.style.display = '';
          rgbChannels.style.display = 'none';
        }
      }

      function convert() {
        var input = hexInput.value.trim().replace(/^#/, '').replace(/\s/g, '');
        if (input.length === 3) {
          input = input[0] + input[0] + input[1] + input[1] + input[2] + input[2];
        }
        if (input.length !== 6 || !/^[0-9A-Fa-f]{6}$/.test(input)) {
          showResult('Invalid hex color', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid hex color — use format #RRGGBB');
          return;
        }
        var r = parseInt(input.substring(0, 2), 16);
        var g = parseInt(input.substring(2, 4), 16);
        var b = parseInt(input.substring(4, 6), 16);
        showResult('rgb(' + r + ', ' + g + ', ' + b + ')', 'valid', r, g, b);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
      }

      btnConvert.onclick = convert;

      btnRandom.onclick = function () {
        var hex = '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0').toUpperCase();
        hexInput.value = hex;
        convert();
      };

      btnClear.addEventListener('click', function () {
        hexInput.value = '';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = rgbOutput.textContent;
        if (text && !rgbOutput.classList.contains('empty') && !rgbOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      hexInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      hexInput.addEventListener('input', function () {
        var input = hexInput.value.trim().replace(/^#/, '').replace(/\s/g, '');
        if (input.length === 3) {
          input = input[0] + input[0] + input[1] + input[1] + input[2] + input[2];
        }
        if (!input) {
          showResult('Result will appear here', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        if (input.length === 6 && /^[0-9A-Fa-f]{6}$/.test(input)) {
          var r = parseInt(input.substring(0, 2), 16);
          var g = parseInt(input.substring(2, 4), 16);
          var b = parseInt(input.substring(4, 6), 16);
          showResult('rgb(' + r + ', ' + g + ', ' + b + ')', 'valid', r, g, b);
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
        }
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
