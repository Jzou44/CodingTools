{% endblock %}

{% block description %}
  <h2>Fraction to Percent Converter</h2>
  <p>This tool converts a mixed fraction (integer + numerator/denominator) into its percentage equivalent. It is useful for math homework, financial calculations, or any situation where you need to express fractions as percentages.</p>
  <p>The conversion runs entirely in your browser. Enter the integer part (optional), the numerator, and the denominator, then click Calculate to see the percentage result.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Enter the integer part (leave empty or 0 if the fraction is less than 1).</li>
    <li>Enter the numerator (top number of the fraction).</li>
    <li>Enter the denominator (bottom number of the fraction).</li>
    <li>Click <strong>Calculate</strong> to see the percentage result.</li>
    <li>Use <strong>Copy</strong> to copy the result to your clipboard, or <strong>Clear</strong> to reset.</li>
  </ol>

  <h3>How it works</h3>
  <p>The percentage is calculated as: <code>percent = (integer + numerator / denominator) * 100</code>. For example, <code>3/4</code> becomes <code>(3 / 4) * 100 = 75%</code>.</p>

  <h3>Example</h3>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">Fraction:  3/4
Percent:   75%

Fraction:  1/2
Percent:   50%

Fraction:  1 1/4
Percent:   125%</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var integerInput     = document.getElementById('integer-input');
      var numeratorInput   = document.getElementById('numerator-input');
      var denominatorInput = document.getElementById('denominator-input');
      var percentOutput    = document.getElementById('percent-output');
      var percentSuffix    = document.getElementById('percent-suffix');
      var outputCard       = document.getElementById('output-card');
      var btnConvert       = document.getElementById('btn-convert');
      var btnClear         = document.getElementById('btn-clear');
      var btnCopy          = document.getElementById('btn-copy');
      var statusMessage    = document.getElementById('status-message');
      var statusDot        = document.getElementById('status-dot');
      var statusText       = document.getElementById('status-text');

      function showResult(text, type) {
        percentOutput.textContent = text;
        percentOutput.className = 'frac-pct-output-value';
        if (type === 'empty') percentOutput.className += ' empty';
        else if (type === 'error') percentOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          percentSuffix.style.display = '';
        } else {
          outputCard.classList.remove('has-result');
          percentSuffix.style.display = 'none';
        }
      }

      function convert() {
        var denStr = denominatorInput.value.trim();
        var numStr = numeratorInput.value.trim();
        if (!denStr || !numStr) return;
        try {
          var denominator = new BigNumber(denStr);
          var numerator   = new BigNumber(numStr);
          var integerVal  = new BigNumber(integerInput.value.trim() || '0');
          if (denominator.isZero()) {
            showResult('Denominator cannot be zero', 'error');
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Denominator cannot be zero');
            return;
          }
          var result = integerVal.plus(numerator.dividedBy(denominator)).multipliedBy(100);
          showResult(result.toString(10), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted successfully');
        } catch (e) {
          showResult('Invalid input', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid input');
        }
      }

      btnConvert.onclick = convert;

      btnClear.addEventListener('click', function () {
        integerInput.value     = '';
        numeratorInput.value   = '';
        denominatorInput.value = '';
        showResult('Result will appear here', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = percentOutput.textContent;
        if (text && !percentOutput.classList.contains('empty') && !percentOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text + '%').then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      denominatorInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });
      numeratorInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });
      integerInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      [integerInput, numeratorInput, denominatorInput].forEach(function (el) {
        el.addEventListener('input', function () {
          var denStr = denominatorInput.value.trim();
          var numStr = numeratorInput.value.trim();
          if (!denStr || !numStr) {
            showResult('Result will appear here', 'empty');
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
            return;
          }
          convert();
        });
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
