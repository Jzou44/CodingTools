      padding: 4px 0;
    }
    .frac-pct-ref-item .frac {
      font-family: 'Fraunces', serif;
      font-weight: 600;
      color: var(--secondary);
      min-width: 36px;
    }
    .frac-pct-ref-item .arrow {
      color: var(--text-muted);
      font-size: 11px;
    }
    .frac-pct-ref-item .pct {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      color: var(--accent);
    }

    @media (max-width: 600px) {
      .frac-pct-field-input { font-size: 22px; width: 64px; padding: 8px; }
      .frac-pct-output-value { font-size: 28px; }
      .frac-pct-output-suffix { font-size: 28px; }
      .frac-pct-input-card, .frac-pct-output-card { padding: 20px; }
    }
  </style>

  <div class="frac-pct-converter">
    <!-- Input Card -->
    <div class="frac-pct-input-card">
      <div class="frac-pct-label">Fraction</div>
      <div class="frac-pct-input-fields">
        <div class="frac-pct-field-group">
          <span class="frac-pct-field-label">Integer</span>
          <input type="text" class="frac-pct-field-input" id="integer-input" placeholder="0" spellcheck="false" autocomplete="off">
        </div>
        <span class="frac-pct-separator">&nbsp;</span>
        <div class="frac-pct-field-group">
          <span class="frac-pct-field-label">Numerator</span>
          <input type="text" class="frac-pct-field-input" id="numerator-input" placeholder="3" spellcheck="false" autocomplete="off">
        </div>
        <span class="frac-pct-slash">⁄</span>
        <div class="frac-pct-field-group">
          <span class="frac-pct-field-label">Denominator</span>
          <input type="text" class="frac-pct-field-input" id="denominator-input" placeholder="4" spellcheck="false" autocomplete="off" autofocus>
        </div>
