---
lang: "tw"
toolId: "rgb-to-hex"
category: "number-conversion"
activeTool: "rgb-to-hex"
permalink: "/tw/rgb-to-hex.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <style>
    .rgb-hex-converter { display: flex; flex-direction: column; gap: 0; }
    .tool-input-card::before { background: linear-gradient(90deg, #e74c3c, #2ecc71, #3498db); }
    .rgb-hex-input-fields { display: flex; gap: 12px; }
    .rgb-hex-field-group { flex: 1; display: flex; flex-direction: column; gap: 6px; }
    .rgb-hex-field-label { font-family: 'DM Sans', sans-serif; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: inherit; }
    .rgb-hex-field-input { width: 100%; font-family: 'IBM Plex Mono', monospace; font-size: 28px; font-weight: 500; color: var(--text-primary); background: var(--code-bg); border: 1px solid var(--border); border-radius: 10px; outline: none; padding: 10px 12px; text-align: center; caret-color: var(--accent); transition: border-color 0.2s, box-shadow 0.2s; }
    .rgb-hex-field-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(196, 93, 58, 0.1); }
    .rgb-hex-field-input::placeholder { color: inherit; font-size: 16px; font-weight: 400; }
    .rgb-hex-field-input.r-field:focus { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.1); }
    .rgb-hex-field-input.g-field:focus { border-color: #27ae60; box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.1); }
    .rgb-hex-field-input.b-field:focus { border-color: #2980b9; box-shadow: 0 0 0 3px rgba(41, 128, 185, 0.1); }
    .rgb-hex-actions { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
    .rgb-hex-arrow { display: flex; align-items: center; justify-content: center; height: 48px; position: relative; }
    .rgb-hex-arrow::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--border); }
    .rgb-hex-arrow-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; position: relative; z-index: 1; box-shadow: 0 2px 8px rgba(196, 93, 58, 0.3); cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; }
    .rgb-hex-arrow-icon:hover { transform: scale(1.08); box-shadow: 0 4px 12px rgba(196, 93, 58, 0.4); }
    .rgb-hex-swatch { margin-top: 16px; border-radius: 12px; height: 96px; background: repeating-conic-gradient(#e8e0d4 0% 25%, #faf8f0 0% 50%) 50% / 20px 20px; position: relative; overflow: hidden; border: 1px solid var(--border); }
    .rgb-hex-swatch-fill { position: absolute; inset: 0; background-color: #cccccc; border-radius: 11px; transition: background-color 0.2s; }
    .rgb-hex-swatch-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: 'DM Sans', sans-serif; font-size: 13px; color: inherit; z-index: 1; pointer-events: none; }
    .rgb-hex-toolbar { display: flex; align-items: center; justify-content: space-between; margin-top: 16px; gap: 8px; }
    .rgb-hex-toolbar-left, .rgb-hex-toolbar-right { display: flex; align-items: center; gap: 8px; }
    @media (max-width: 600px) { .rgb-hex-field-input { font-size: 22px; padding: 8px; } .rgb-hex-swatch { height: 72px; } }
  </style>

  <div class="rgb-hex-converter">
    <div class="tool-input-card">
      <div class="tool-label">{{ t.ui.rgbColor }}</div>
      <div class="rgb-hex-input-fields">
        <div class="rgb-hex-field-group">
          <span class="rgb-hex-field-label">Red (R)</span>
          <input type="number" class="rgb-hex-field-input r-field" id="r-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off">
        </div>
        <div class="rgb-hex-field-group">
          <span class="rgb-hex-field-label">Green (G)</span>
          <input type="number" class="rgb-hex-field-input g-field" id="g-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off">
        </div>
        <div class="rgb-hex-field-group">
          <span class="rgb-hex-field-label">Blue (B)</span>
          <input type="number" class="rgb-hex-field-input b-field" id="b-input" min="0" max="255" placeholder="0–255" spellcheck="false" autocomplete="off" autofocus>
        </div>
      </div>
      <div class="tool-hint">{{ toolData.inputHint | safe }}</div>
      <div class="rgb-hex-actions">
        <button class="btn btn-secondary" id="btn-random" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          {{ t.ui.pickRandomColor }}
        </button>
      </div>
    </div>

    <div class="rgb-hex-arrow">
      <div class="rgb-hex-arrow-icon" id="btn-convert" title="{{ t.ui.convert }}"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg></div>
    </div>

    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent)">
      <div class="tool-output-label">
        <span>{{ t.ui.hexColor }}</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="{{ t.ui.copy }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          {{ t.ui.copy }}
        </button>
      </div>
      <div class="tool-output-value empty" id="hex-output">{{ toolData.resultPlaceholder }}</div>
      <div class="rgb-hex-swatch" id="swatch-container">
        <div class="rgb-hex-swatch-fill" id="color-preview"></div>
        <div class="rgb-hex-swatch-empty" id="swatch-placeholder">{{ t.ui.preview }}</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="rgb-hex-toolbar">
      <div class="rgb-hex-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          {{ t.ui.clear }}
        </button>
      </div>
      <div class="rgb-hex-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';
      var rInput = document.getElementById('r-input');
      var gInput = document.getElementById('g-input');
      var bInput = document.getElementById('b-input');
      var hexOutput = document.getElementById('hex-output');
      var outputCard = document.getElementById('output-card');
      var colorPreview = document.getElementById('color-preview');
      var swatchPlaceholder = document.getElementById('swatch-placeholder');
      var btnConvert = document.getElementById('btn-convert');
      var btnRandom = document.getElementById('btn-random');
      var btnClear = document.getElementById('btn-clear');
      var btnCopy = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot = document.getElementById('status-dot');
      var statusText = document.getElementById('status-text');

      function toHex(n) {
        var hex = parseInt(n, 10).toString(16).toUpperCase();
        return hex.length === 1 ? '0' + hex : hex;
      }

      function showResult(text, type, hex) {
        hexOutput.textContent = text;
        hexOutput.className = 'tool-output-value';
        if (type === 'empty') hexOutput.className += ' empty';
        else if (type === 'error') hexOutput.className += ' error';
        if (type === 'valid') {
          outputCard.classList.add('has-result');
          colorPreview.style.backgroundColor = hex;
          swatchPlaceholder.style.display = 'none';
        } else {
          outputCard.classList.remove('has-result');
          colorPreview.style.backgroundColor = 'transparent';
          swatchPlaceholder.style.display = '';
        }
      }

      function convert() {
        var r = parseInt(rInput.value, 10);
        var g = parseInt(gInput.value, 10);
        var b = parseInt(bInput.value, 10);
        if (isNaN(r) || isNaN(g) || isNaN(b) || r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) {
          showResult('{{ t.ui.invalidRgbInput }}', 'error');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', '{{ t.ui.rgbRangeHint }}');
          return;
        }
        var hex = '#' + toHex(r) + toHex(g) + toHex(b);
        showResult(hex, 'valid', hex);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', '{{ t.ui.convertedSuccessfully }}');
      }

      btnConvert.onclick = convert;
      btnRandom.onclick = function () {
        rInput.value = Math.floor(Math.random() * 256);
        gInput.value = Math.floor(Math.random() * 256);
        bInput.value = Math.floor(Math.random() * 256);
        convert();
      };

      btnClear.addEventListener('click', function () {
        rInput.value = '';
        gInput.value = '';
        bInput.value = '';
        showResult('{{ toolData.resultPlaceholder }}', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = hexOutput.textContent;
        if (text && !hexOutput.classList.contains('empty') && !hexOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> {{ t.ui.copied }}';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      [rInput, gInput, bInput].forEach(function (el) {
        el.addEventListener('keydown', function (e) { if (e.key === 'Enter') btnConvert.click(); });
      });

      function liveConvert() {
        var r = parseInt(rInput.value, 10);
        var g = parseInt(gInput.value, 10);
        var b = parseInt(bInput.value, 10);
        if (rInput.value === '' && gInput.value === '' && bInput.value === '') {
          showResult('{{ toolData.resultPlaceholder }}', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        if (isNaN(r) || isNaN(g) || isNaN(b) || r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255) return;
        var hex = '#' + toHex(r) + toHex(g) + toHex(b);
        showResult(hex, 'valid', hex);
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', '{{ t.ui.converted }}');
      }

      rInput.addEventListener('input', liveConvert);
      gInput.addEventListener('input', liveConvert);
      bInput.addEventListener('input', liveConvert);

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}