---
lang: "tw"
toolId: "password-generator"
category: "hash-cryptography"
activeTool: "password-generator"
permalink: "/tw/password-generator.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <label class="section-label">{{ t.ui.options }}</label>
  <div class="options-panel">
    <div class="option-row">
      <span class="option-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
        {{ t.ui.passwordLength }}
      </span>
      <span class="option-value" id="length-display">16</span>
    </div>
    <div class="slider-row">
      <input type="range" class="length-slider" id="password-length" min="4" max="128" value="16">
    </div>
    <div class="option-row">
      <label class="checkbox-label">
        <input type="checkbox" id="opt-uppercase" checked>
        {{ t.ui.uppercase }}
      </label>
      <span class="charset-hint">A–Z</span>
    </div>
    <div class="option-row">
      <label class="checkbox-label">
        <input type="checkbox" id="opt-lowercase" checked>
        {{ t.ui.lowercase }}
      </label>
      <span class="charset-hint">a–z</span>
    </div>
    <div class="option-row">
      <label class="checkbox-label">
        <input type="checkbox" id="opt-numbers" checked>
        {{ t.ui.numbers }}
      </label>
      <span class="charset-hint">0–9</span>
    </div>
    <div class="option-row">
      <label class="checkbox-label">
        <input type="checkbox" id="opt-symbols" checked>
        {{ t.ui.symbols }}
      </label>
      <span class="charset-hint">!@#$%^&amp;*</span>
    </div>
  </div>

  <label class="section-label" for="output-editor">{{ t.ui.generatedPassword }}</label>
  <div class="editor-wrapper readonly-wrapper">
    <textarea class="editor-area readonly" id="output-editor" spellcheck="false" readonly placeholder="{{ toolData.outputPlaceholder }}"></textarea>
  </div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="btn btn-primary" id="btn-generate" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
        {{ t.ui.generate }}
      </button>
      <button class="btn btn-ghost" id="btn-clear" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
        {{ t.ui.clear }}
      </button>
    </div>
    <div class="toolbar-right">
            <button class="btn btn-ghost" id="btn-copy" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        {{ t.ui.copy }}
      </button>
      <button class="btn btn-ghost" id="btn-download" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        {{ t.ui.download }}
      </button>
    </div>
  </div>

  <div class="status-bar">
    <div class="status-message idle" id="status-message">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
    <div class="status-meta">
      <span id="char-count">0 {{ t.ui.characters }}</span>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>{{ toolData.descTitle }}</h2>
  {% for para in toolData.descParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.howToUse }}</h3>
  <ol class="steps-list">
    {% for step in toolData.steps %}
    <li>{{ step | safe }}</li>
    {% endfor %}
  </ol>

  <h3>{{ toolData.whatIs }}</h3>
  {% for para in toolData.whatIsParas %}
  <p>{{ para | safe }}</p>
  {% endfor %}

  <h3>{{ toolData.inputNotes }}</h3>
  <p>{{ toolData.inputNotesPara | safe }}</p>

  <h3>{{ toolData.example }}</h3>
  <p>{{ toolData.examplePara | safe }}</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">{{ t.ui.copyExample }}</button>
    <pre class="code-block" id="example-code">{{ toolData.exampleCode | safe }}</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var outputEditor   = document.getElementById('output-editor');
      var btnGenerate    = document.getElementById('btn-generate');
      var btnClear       = document.getElementById('btn-clear');
      var btnCopy        = document.getElementById('btn-copy');
      var btnDownload    = document.getElementById('btn-download');
      var statusMessage  = document.getElementById('status-message');
      var statusDot      = document.getElementById('status-dot');
      var statusText     = document.getElementById('status-text');
      var charCount      = document.getElementById('char-count');
      var lengthSlider   = document.getElementById('password-length');
      var lengthDisplay  = document.getElementById('length-display');
      var optUppercase   = document.getElementById('opt-uppercase');
      var optLowercase   = document.getElementById('opt-lowercase');
      var optNumbers     = document.getElementById('opt-numbers');
      var optSymbols     = document.getElementById('opt-symbols');

      var CHARS_UPPER   = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      var CHARS_LOWER   = 'abcdefghijklmnopqrstuvwxyz';
      var CHARS_NUMBERS = '0123456789';
      var CHARS_SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';

      function generatePassword() {
        var length = parseInt(lengthSlider.value, 10);
        var charset = '';
        if (optUppercase.checked) charset += CHARS_UPPER;
        if (optLowercase.checked) charset += CHARS_LOWER;
        if (optNumbers.checked)   charset += CHARS_NUMBERS;
        if (optSymbols.checked)   charset += CHARS_SYMBOLS;

        if (!charset) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', 'Select at least one character type');
          outputEditor.value = '';
          charCount.textContent = '0 {{ t.ui.characters }}';
          return;
        }

        var array = new Uint32Array(length);
        crypto.getRandomValues(array);
        var password = '';
        for (var i = 0; i < length; i++) {
          password += charset[array[i] % charset.length];
        }

        outputEditor.value = password;
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Password generated \u2014 ' + ToolCommon.pluralise(length, '{{ t.ui.character }}', '{{ t.ui.characters }}'));
        charCount.textContent = ToolCommon.pluralise(password.length, '{{ t.ui.character }}', '{{ t.ui.characters }}');
      }

      btnGenerate.addEventListener('click', generatePassword);

      btnClear.addEventListener('click', function () {
        outputEditor.value = '';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        charCount.textContent = '0 {{ t.ui.characters }}';
        lengthSlider.value = 16;
        lengthDisplay.textContent = '16';
        optUppercase.checked = true;
        optLowercase.checked = true;
        optNumbers.checked = true;
        optSymbols.checked = true;
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(outputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(outputEditor, 'password.txt');
      });

      lengthSlider.addEventListener('input', function () {
        lengthDisplay.textContent = this.value;
      });

      [optUppercase, optLowercase, optNumbers, optSymbols].forEach(function (cb) {
        cb.addEventListener('change', function () {
          if (outputEditor.value) generatePassword();
        });
      });

      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnGenerate);
    })();
  </script>
{% endblock %}
