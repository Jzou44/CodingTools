---
category: "string-text-utilities"
activeTool: "word-counter"
permalink: "/word-counter.html"
---

{% extends "tool-layout.njk" %}

{% import "macros/editor.njk" as editor %}
{% import "macros/toolbar.njk" as toolbar %}
{% import "macros/status-bar.njk" as status %}

{% block tool_content %}
  {{ editor.inputEditor("Paste or type your text here to count words, characters, sentences, and paragraphs...") }}

  {% call toolbar.toolbar("Clear", "Copy", "Download") %}
  {% endcall %}

  <!-- Statistics Panel -->
  <div style="margin-top: 24px;">
    <label class="section-label">Statistics</label>
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-label">Words</span>
        <span class="stat-value" id="stat-words">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Characters (with spaces)</span>
        <span class="stat-value" id="stat-chars-spaces">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Characters (no spaces)</span>
        <span class="stat-value" id="stat-chars-nospaces">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Sentences</span>
        <span class="stat-value" id="stat-sentences">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Paragraphs</span>
        <span class="stat-value" id="stat-paragraphs">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Lines</span>
        <span class="stat-value" id="stat-lines">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Reading time</span>
        <span class="stat-value" id="stat-reading-time">~0 min</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Speaking time</span>
        <span class="stat-value" id="stat-speaking-time">~0 min</span>
      </div>
    </div>
  </div>

  {{ status.statusBar("characters", "lines") }}
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var inputEditor   = document.getElementById('input-editor');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var charCount     = document.getElementById('char-count');
      var lineCount     = document.getElementById('line-count');
      var inputLineNums = document.getElementById('input-line-numbers');

      var statWords        = document.getElementById('stat-words');
      var statCharsSpaces  = document.getElementById('stat-chars-spaces');
      var statCharsNoSpaces = document.getElementById('stat-chars-nospaces');
      var statSentences    = document.getElementById('stat-sentences');
      var statParagraphs   = document.getElementById('stat-paragraphs');
      var statLines        = document.getElementById('stat-lines');
      var statReadingTime  = document.getElementById('stat-reading-time');
      var statSpeakingTime = document.getElementById('stat-speaking-time');

      function countWords(text) {
        var trimmed = text.trim();
        if (!trimmed) return 0;
        return trimmed.split(/\s+/).filter(function (w) { return w.length > 0; }).length;
      }

      function countSentences(text) {
        if (!text.trim()) return 0;
        var matches = text.match(/[.!?]+[\s​]+|[.!?]+$|[.!?]+$/gm);
        return matches ? matches.length : 0;
      }

      function countParagraphs(text) {
        if (!text.trim()) return 0;
        var blocks = text.split(/\n\s*\n/);
        var count = 0;
        for (var i = 0; i < blocks.length; i++) {
          if (blocks[i].trim().length > 0) count++;
        }
        return count;
      }

      function formatTime(minutes) {
        if (minutes < 1) return '< 1 min';
        if (minutes < 60) return '~' + Math.ceil(minutes) + ' min';
        var hours = Math.floor(minutes / 60);
        var mins = Math.ceil(minutes % 60);
        return '~' + hours + ' hr' + (hours !== 1 ? 's' : '') + (mins > 0 ? ' ' + mins + ' min' : '');
      }

      function updateStats() {
        var text = inputEditor.value;
        var words = countWords(text);
        var charsSpaces = text.length;
        var charsNoSpaces = text.replace(/\s/g, '').length;
        var sentences = countSentences(text);
        var paragraphs = countParagraphs(text);
        var lines = ToolCommon.countLines(text);
        var readingTime = words / 200;
        var speakingTime = words / 130;

        statWords.textContent = words;
        statCharsSpaces.textContent = charsSpaces;
        statCharsNoSpaces.textContent = charsNoSpaces;
        statSentences.textContent = sentences;
        statParagraphs.textContent = paragraphs;
        statLines.textContent = lines;
        statReadingTime.textContent = formatTime(readingTime);
        statSpeakingTime.textContent = formatTime(speakingTime);

        charCount.textContent = ToolCommon.pluralise(charsSpaces, 'character');
        lineCount.textContent = ToolCommon.pluralise(lines, 'line');
        ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
      }

      inputEditor.addEventListener('input', function () {
        updateStats();
        if (inputEditor.value) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Statistics updated');
        } else {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        }
      });

      btnClear.addEventListener('click', function () {
        inputEditor.value = '';
        updateStats();
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
        inputEditor.focus();
      });

      btnCopy.addEventListener('click', function () {
        ToolCommon.copyOutput(inputEditor, btnCopy);
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput(inputEditor, 'word-counter-input.txt');
      });

      // Init shared behaviors
      ToolCommon.initInputLineNumbers(inputEditor, inputLineNums);
      ToolCommon.initScrollSync(inputEditor, inputLineNums);
      ToolCommon.initTabKey(inputEditor, inputLineNums);
      ToolCommon.initExampleCopy();
      ToolCommon.updateLineNumbers(inputEditor, inputLineNums);
    })();
  </script>
{% endblock %}
