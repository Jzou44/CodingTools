{% extends "tool-layout.njk" %}

{% block tool_content %}
  <div class="dropzone-area" id="dropzone" role="button" tabindex="0">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
    <p>Click or drag JPEG files here to upload</p>
    <span class="dropzone-hint">Up to 20 images · Max 10MB each</span>
    <input type="file" id="file-input" accept="image/jpeg" multiple hidden>
  </div>

  <div class="toolbar">
    <div class="toolbar-left">
      <button class="btn btn-ghost" id="btn-clear" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        Clear Queue
      </button>
    </div>
    <div class="toolbar-right">
      <button class="btn btn-primary" id="btn-download-all" type="button" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Download All
      </button>
    </div>
  </div>

  <div id="file-list" class="file-list"></div>

  <div class="status-bar">
    <div class="status-message idle" id="status-message">
      <span class="status-dot" id="status-dot" style="display:none;"></span>
      <span id="status-text"></span>
    </div>
    <div class="status-meta">
      <span id="file-count">0 files</span>
    </div>
  </div>
{% endblock %}

{% block description %}
  <h2>Progressive JPEG</h2>
  <p>This tool re-encodes JPEG images at full quality (100%). Progressive JPEGs load in multiple passes, showing a low-quality preview that gradually sharpens — providing a better user experience on slow connections.</p>
  <p><strong>Note:</strong> The browser Canvas API does not support true progressive encoding. This tool re-encodes at quality 100%, producing a valid baseline JPEG. For true progressive encoding, use server-side tools like ImageMagick or Pillow.</p>

  <h3>How to use</h3>
  <ol class="steps-list">
    <li>Drag and drop JPEG files onto the upload area, or click to select files.</li>
    <li>Each file is re-encoded at full quality and the size change is displayed.</li>
    <li>Download individual files or use <strong>Download All</strong> to get a ZIP archive.</li>
  </ol>

  <h3>Baseline vs Progressive JPEG</h3>
  <p><strong>Baseline JPEG:</strong> Loads top-to-bottom in a single pass. The image appears line by line as data arrives.</p>
  <p><strong>Progressive JPEG:</strong> Loads in multiple passes. First a blurry full image appears, then it sharpens progressively. This gives users a preview of the full image before it fully loads.</p>
  <p><strong>File size:</strong> Progressive JPEGs are often slightly smaller than baseline JPEGs at the same quality level, making them a win-win for web performance.</p>

  <h3>Create with Python</h3>
  <p>Create a progressive JPEG using Python with the Pillow library:</p>
  <div class="code-block-wrapper">
    <button class="code-block-copy" id="example-copy" type="button">Copy</button>
    <pre class="code-block" id="example-code">from PIL import Image

original = Image.open('input.jpg')
original.save('progressive.jpeg', optimize=True, quality=100, progressive=True)</pre>
  </div>
{% endblock %}

{% block tool_script %}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script>
    (function () {
      'use strict';

      var dropzone = document.getElementById('dropzone');
      var fileInput = document.getElementById('file-input');
      var fileList = document.getElementById('file-list');
      var btnClear = document.getElementById('btn-clear');
      var btnDownloadAll = document.getElementById('btn-download-all');
      var statusMessage = document.getElementById('status-message');
      var statusDot = document.getElementById('status-dot');
      var statusText = document.getElementById('status-text');
      var fileCount = document.getElementById('file-count');

      var results = [];
      var MAX_FILES = 20;
      var MAX_SIZE = 10 * 1024 * 1024;

      dropzone.addEventListener('click', function () { fileInput.click(); });
      dropzone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          fileInput.click();
        }
      });
      dropzone.addEventListener('dragover', function (e) { e.preventDefault(); dropzone.classList.add('dragover'); });
      dropzone.addEventListener('dragleave', function () { dropzone.classList.remove('dragover'); });
      dropzone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        handleFiles(e.dataTransfer.files);
      });
      fileInput.addEventListener('change', function () { handleFiles(this.files); this.value = ''; });

      function handleFiles(files) {
        var remaining = MAX_FILES - results.length;
        var toProcess = Array.from(files).slice(0, remaining);
        toProcess.forEach(function (file) {
          if (file.size > MAX_SIZE) return;
          if (!file.type.match(/image\/jpeg/)) return;
          processFile(file);
        });
      }

      function processFile(file) {
        var id = 'file-' + Date.now() + '-' + Math.random().toString(36).substr(2, 5);
        var item = ToolCommon.appendFileStatusItem(fileList, id, file.name, '{{ t.ui.processing }}');

        function failFile(message) {
          var statusEl = item.querySelector('.file-status');
          statusEl.textContent = message || '{{ t.ui.invalidInput }}';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', message || '{{ t.ui.invalidInput }}');
        }

        var reader = new FileReader();
        reader.onload = function (e) {
          var img = new Image();
          img.onload = function () {
            var canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            var ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0);
            if (typeof canvas.toBlob !== 'function') { failFile('{{ t.ui.invalidInput }}'); return; }
            canvas.toBlob(function (blob) {
              if (!blob) { failFile('{{ t.ui.invalidInput }}'); return; }
              var originalSize = file.size;
              var compressedSize = blob.size;
              var rate = ((compressedSize - originalSize) / originalSize * 100).toFixed(1);
              var url = URL.createObjectURL(blob);
              var name = ToolCommon.sanitizeDownloadFilename(file.name.replace(/\.jpe?g$/i, '') + '-progressive.jpg', 'progressive.jpg');

              results.push({ name: name, blob: blob, url: url });

              var statusEl = item.querySelector('.file-status');
              ToolCommon.setDownloadStatus(statusEl, rate + '%', url, name, '{{ t.ui.download }}');

              fileCount.textContent = results.length + ' files';
              btnDownloadAll.disabled = false;
              ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', results.length + ' file(s) processed');
            }, 'image/jpeg', 1.0);
          };
          img.onerror = function () { failFile('{{ t.ui.invalidInput }}'); };
          img.src = e.target.result;
        };
        reader.onerror = function () { failFile('{{ t.ui.invalidInput }}'); };
        reader.readAsDataURL(file);
      }

      btnClear.addEventListener('click', function () {
        results.forEach(function (r) { URL.revokeObjectURL(r.url); });
        results = [];
        ToolCommon.clearElement(fileList);
        btnDownloadAll.disabled = true;
        fileCount.textContent = '0 files';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnDownloadAll.addEventListener('click', function () {
        if (results.length === 0) return;
        if (results.length === 1) {
          var a = document.createElement('a');
          a.href = results[0].url;
          a.download = ToolCommon.sanitizeDownloadFilename(results[0].name, 'download');
          a.click();
          return;
        }
        var zip = new JSZip();
        var pending = results.length;
        results.forEach(function (r) {
          zip.file(r.name, r.blob);
        });
        zip.generateAsync({ type: 'blob' }).then(function (content) {
          var url = URL.createObjectURL(content);
          var a = document.createElement('a');
          a.href = url;
          a.download = 'progressive-jpeg.zip';
          a.click();
          URL.revokeObjectURL(url);
        });
      });

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
