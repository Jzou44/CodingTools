---
category: "string-text-utilities"
activeTool: "regex-replace"
permalink: "/regex-replace.html"
---

{% extends "tool-layout.njk" %}

{% block head_extra %}
  <link rel="stylesheet" href="/css/tool.css?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.css">
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/lib/codemirror.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/codemirror@5.65.21/mode/xml/xml.min.js"></script>
{% endblock %}

{% block tool_content %}
  <style>
    .dual-pane { display: flex; flex-direction: column; gap: 0; }

    .pane-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      position: relative;
      overflow: hidden;
    }
    .pane-card--input { border-left: 4px solid var(--accent); }
    .pane-card--output { border-left: 4px solid var(--secondary); }

    .pane-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .pane-label-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }
    .pane-label-dot--accent { background: var(--accent); }
    .pane-label-dot--secondary { background: var(--secondary); }

    .regex-pattern-input {
      width: 100%;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      padding: 10px 12px;
      background: #fff;
      border: 1px solid #e8e4dc;
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      outline: none;
      margin-bottom: 12px;
    }
    .regex-pattern-input::placeholder { color: var(--text-muted); }
    .regex-pattern-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(196, 93, 58, 0.12);
    }

    .replacement-input {
      width: 100%;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      padding: 10px 12px;
      background: #fff;
      border: 1px solid #e8e4dc;
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      outline: none;
      margin-bottom: 12px;
    }
    .replacement-input::placeholder { color: var(--text-muted); }
    .replacement-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(196, 93, 58, 0.12);
    }

    .flags-row {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .flags-row label {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 13px;
      cursor: pointer;
    }
    .flags-row label span {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 12px;
    }
    .flags-row label small {
      color: var(--text-muted);
      font-size: 11px;
    }

    .pane-card .CodeMirror {
      height: 200px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      line-height: 1.6;
      background: #fff;
      border: 1px solid #e8e4dc;
      border-radius: var(--radius-sm);
      padding: 4px 0;
    }
    .pane-card .CodeMirror-scroll { padding: 8px 12px; }
    .pane-card .CodeMirror-gutters {
      background: #fff;
      border-right: 1px solid var(--border);
    }

    .pane-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 0;
      gap: 8px;
      flex-wrap: wrap;
    }
    .pane-toolbar-left,
    .pane-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .highlight-box {
      min-height: 100px;
      padding: 16px;
      background: #fff;
      border: 1px solid #e8e4dc;
      border-radius: var(--radius-sm);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 14px;
      line-height: 1.7;
      color: var(--text-primary);
      white-space: pre-wrap;
      word-break: break-all;
    }
    .highlight-box mark {
      background: var(--accent-light);
      color: var(--accent);
      border-radius: 3px;
      padding: 1px 2px;
    }
    .highlight-box .muted {
      color: var(--text-muted);
      font-style: italic;
    }

    .status-bar-dual {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 4px 0;
      font-size: 12px;
      color: inherit;
    }
    .status-meta-dual {
      display: flex;
      gap: 16px;
    }
    .status-meta-dual span {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
    }

    @media (max-width: 600px) {
      .pane-card { padding: 16px; }
      .pane-card .CodeMirror { height: 160px; font-size: 13px; }
      .pane-toolbar { gap: 6px; }
    }
  </style>

  <div class="dual-pane">
    <!-- Input Card -->
    <div class="pane-card pane-card--input">
      <div class="pane-label">
        <span><span class="pane-label-dot pane-label-dot--accent"></span>Regex Pattern</span>
      </div>
      <input type="text" class="regex-pattern-input" id="regex-input" placeholder="Enter regex pattern, e.g. \b\w+@\w+\.\w+\b">

      <div class="flags-row">
        <label class="checkbox-label"><input type="checkbox" id="flag-g" checked> <span>g</span> <small>global</small></label>
        <label class="checkbox-label"><input type="checkbox" id="flag-i"> <span>i</span> <small>case-insensitive</small></label>
        <label class="checkbox-label"><input type="checkbox" id="flag-m"> <span>m</span> <small>multiline</small></label>
        <label class="checkbox-label"><input type="checkbox" id="flag-s"> <span>s</span> <small>dotAll</small></label>
        <label class="checkbox-label"><input type="checkbox" id="flag-u"> <span>u</span> <small>unicode</small></label>
        <label class="checkbox-label"><input type="checkbox" id="flag-y"> <span>y</span> <small>sticky</small></label>
      </div>

      <div class="pane-label">
        <span>Replace With</span>
      </div>
      <input type="text" class="replacement-input" id="replace-input" placeholder="Replacement string (supports $1, $2 backreferences)">

      <div class="pane-label">
        <span>Test Text</span>
      </div>
      <textarea id="code1" placeholder="Enter or paste text to search and replace..."></textarea>
    </div>

    <!-- Toolbar -->
    <div class="pane-toolbar">
      <div class="pane-toolbar-left">
        <button class="btn btn-primary" id="btn-replace" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
          Replace All
        </button>
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="pane-toolbar-right">
        <button class="btn btn-ghost" id="btn-copy" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
        <button class="btn btn-ghost" id="btn-download" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download
        </button>
      </div>
    </div>

    <!-- Output Card -->
    <div class="pane-card pane-card--output">
      <div class="pane-label">
        <span><span class="pane-label-dot pane-label-dot--secondary"></span>Match Preview</span>
      </div>
      <div id="match-output" class="highlight-box"><span class="muted">Matches will appear here...</span></div>
    </div>

    <!-- Status Bar -->
    <div class="status-bar-dual">
      <div class="status-message idle" id="status-message">
        <span class="status-dot" id="status-dot" style="display:none;"></span>
        <span id="status-text"></span>
      </div>
      <div class="status-meta-dual">
        <span id="char-count">0 characters</span>
        <span id="match-count">0 matches</span>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var editor = CodeMirror.fromTextArea(document.getElementById('code1'), { lineNumbers: true, lineWrapping: true });

      var regexInput    = document.getElementById('regex-input');
      var replaceInput  = document.getElementById('replace-input');
      var matchOutput   = document.getElementById('match-output');
      var btnReplace    = document.getElementById('btn-replace');
      var btnClear      = document.getElementById('btn-clear');
      var btnCopy       = document.getElementById('btn-copy');
      var btnDownload   = document.getElementById('btn-download');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');
      var matchCount    = document.getElementById('match-count');
      var charCount     = document.getElementById('char-count');
      var flagG         = document.getElementById('flag-g');
      var flagI         = document.getElementById('flag-i');
      var flagM         = document.getElementById('flag-m');
      var flagS         = document.getElementById('flag-s');
      var flagU         = document.getElementById('flag-u');
      var flagY         = document.getElementById('flag-y');

      function escapeHtml(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function getFlags() {
        var flags = '';
        if (flagG.checked) flags += 'g';
        if (flagI.checked) flags += 'i';
        if (flagM.checked) flags += 'm';
        if (flagS.checked) flags += 's';
        if (flagU.checked) flags += 'u';
        if (flagY.checked) flags += 'y';
        return flags;
      }

      function previewRegex() {
        var pattern = regexInput.value;
        var text = editor.getValue();

        if (!pattern || !text) {
          matchOutput.innerHTML = text ? escapeHtml(text) : '<span class="muted">Matches will appear here...</span>';
          matchCount.textContent = '0 matches';
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          charCount.textContent = ToolCommon.pluralise(text.length, 'character');
          return;
        }

        try {
          var flags = getFlags();
          if (!flags.includes('g')) flags += 'g';
          var regex = new RegExp(pattern, flags);
          var matches = [];
          var match;

          while ((match = regex.exec(text)) !== null) {
            matches.push({ index: match.index, length: match[0].length, value: match[0] });
            if (match[0].length === 0) { regex.lastIndex++; }
            if (matches.length > 10000) break;
          }

          if (matches.length === 0) {
            matchOutput.innerHTML = escapeHtml(text);
            matchCount.textContent = '0 matches';
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'No matches found');
            charCount.textContent = ToolCommon.pluralise(text.length, 'character');
            return;
          }

          var html = '';
          var lastIndex = 0;
          for (var i = 0; i < matches.length; i++) {
            html += escapeHtml(text.substring(lastIndex, matches[i].index));
            html += '<mark>' + escapeHtml(matches[i].value) + '</mark>';
            lastIndex = matches[i].index + matches[i].length;
          }
          html += escapeHtml(text.substring(lastIndex));

          matchOutput.innerHTML = html;
          matchCount.textContent = matches.length + (matches.length === 1 ? ' match' : ' matches');
          charCount.textContent = ToolCommon.pluralise(text.length, 'character');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', matches.length + (matches.length === 1 ? ' match found' : ' matches found'));
        } catch (e) {
          matchOutput.innerHTML = '<span class="muted">Invalid regex pattern</span>';
          matchCount.textContent = '0 matches';
          charCount.textContent = ToolCommon.pluralise(text.length, 'character');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid regex: ' + e.message);
        }
      }

      btnReplace.onclick = function () {
        var pattern = regexInput.value;
        var replacement = replaceInput.value;
        var text = editor.getValue();

        if (!pattern || !text) return;

        try {
          var flags = getFlags();
          if (!flags.includes('g')) flags += 'g';
          var regex = new RegExp(pattern, flags);
          var result = text.replace(regex, replacement);

          if (result === text) {
            ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'No matches to replace');
            return;
          }

          editor.setValue(result);
          previewRegex();
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Replaced successfully');
        } catch (e) {
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid regex: ' + e.message);
        }
      };

      regexInput.addEventListener('input', previewRegex);
      editor.on('change', previewRegex);
      [flagG, flagI, flagM, flagS, flagU, flagY].forEach(function (cb) {
        cb.addEventListener('change', previewRegex);
      });

      btnClear.addEventListener('click', function () {
        regexInput.value = '';
        replaceInput.value = '';
        editor.setValue('');
        matchOutput.innerHTML = '<span class="muted">Matches will appear here...</span>';
        matchCount.textContent = '0 matches';
        charCount.textContent = '0 characters';
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = editor.getValue();
        if (text) {
          navigator.clipboard.writeText(text).then(function () {
            btnCopy.textContent = 'Copied!';
            setTimeout(function () { btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copy'; }, 1500);
          });
        }
      });

      btnDownload.addEventListener('click', function () {
        ToolCommon.downloadOutput({ value: editor.getValue() }, 'regex-replace.txt');
      });

      ToolCommon.initExampleCopy();
      ToolCommon.initKeyboardShortcut(btnReplace);
    })();
  </script>
{% endblock %}
