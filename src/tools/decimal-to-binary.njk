---
category: "number-conversion"
activeTool: "decimal-to-binary"
permalink: "/decimal-to-binary.html"
---

{% extends "tool-layout.njk" %}

{% block tool_content %}
  <style>
    .nc-converter { display: flex; flex-direction: column; gap: 0; }

    .nc-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 48px;
      position: relative;
    }
    .nc-arrow::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }
    .nc-arrow-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--secondary);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      box-shadow: 0 2px 8px rgba(45, 106, 79, 0.3);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .nc-arrow-icon:hover {
      transform: scale(1.08);
      box-shadow: 0 4px 12px rgba(45, 106, 79, 0.4);
    }

    .nc-secondary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }
    .nc-secondary-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: border-color 0.3s;
    }
    .nc-secondary-card.has-result { border-color: var(--secondary); }
    .nc-secondary-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 8px;
    }
    .nc-secondary-value {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 18px;
      font-weight: 500;
      color: var(--text-primary);
      word-break: break-all;
      min-height: 24px;
      line-height: 1.3;
    }
    .nc-secondary-value.empty {
      color: inherit;
      font-size: 14px;
      font-weight: 400;
      font-style: italic;
    }

    .nc-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      gap: 8px;
    }
    .nc-toolbar-left, .nc-toolbar-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nc-ref {
      margin-top: 24px;
      background: var(--code-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
    }
    .nc-ref-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: inherit;
      margin-bottom: 12px;
    }
    .nc-ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 6px;
    }
    .nc-ref-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      padding: 4px 0;
    }
    .nc-ref-item .dec {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 500;
      color: var(--text-secondary);
      min-width: 28px;
    }
    .nc-ref-item .arrow { color: inherit; font-size: 11px; }
    .nc-ref-item .bin {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      color: var(--secondary);
    }

    @media (max-width: 600px) {
      .nc-secondary-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="nc-converter">
    <!-- Input Card -->
    <div class="tool-input-card" style="--tool-accent: var(--accent)">
      <div class="tool-label">Decimal</div>
      <input type="text" class="tool-input-field" id="decimal-input" placeholder="Enter decimal value (e.g. 255)" spellcheck="false" autocomplete="off" autofocus>
      <div class="tool-hint">Valid: <code>0-9</code> (integers)</div>
    </div>

    <!-- Arrow -->
    <div class="nc-arrow">
      <div class="nc-arrow-icon" id="btn-convert" title="Convert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
      </div>
    </div>

    <!-- Primary Output Card -->
    <div class="tool-output-card" id="output-card" style="--tool-accent: var(--accent)">
      <div class="tool-output-label">
        <span>Binary (Base 2)</span>
        <button class="btn btn-ghost btn-sm" id="btn-copy" type="button" title="Copy to clipboard">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy
        </button>
      </div>
      <div class="tool-output-value empty" id="binary-output">Result will appear here</div>
    </div>

    <!-- Secondary Results -->
    <div class="nc-secondary-grid">
      <div class="nc-secondary-card" id="hex-card">
        <div class="nc-secondary-label">Hexadecimal (Base 16)</div>
        <div class="nc-secondary-value empty" id="hex-output">&mdash;</div>
      </div>
      <div class="nc-secondary-card" id="octal-card">
        <div class="nc-secondary-label">Octal (Base 8)</div>
        <div class="nc-secondary-value empty" id="octal-output">&mdash;</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="nc-toolbar">
      <div class="nc-toolbar-left">
        <button class="btn btn-ghost" id="btn-clear" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          Clear
        </button>
      </div>
      <div class="nc-toolbar-right">
        <div class="status-message idle" id="status-message">
          <span class="status-dot" id="status-dot" style="display:none;"></span>
          <span id="status-text"></span>
        </div>
      </div>
    </div>

    <!-- Quick Reference -->
    <div class="nc-ref">
      <div class="nc-ref-title">Quick Reference</div>
      <div class="nc-ref-grid">
        <div class="nc-ref-item"><span class="dec">0</span><span class="arrow">&rarr;</span><span class="bin">0</span></div>
        <div class="nc-ref-item"><span class="dec">1</span><span class="arrow">&rarr;</span><span class="bin">1</span></div>
        <div class="nc-ref-item"><span class="dec">2</span><span class="arrow">&rarr;</span><span class="bin">10</span></div>
        <div class="nc-ref-item"><span class="dec">4</span><span class="arrow">&rarr;</span><span class="bin">100</span></div>
        <div class="nc-ref-item"><span class="dec">8</span><span class="arrow">&rarr;</span><span class="bin">1000</span></div>
        <div class="nc-ref-item"><span class="dec">16</span><span class="arrow">&rarr;</span><span class="bin">10000</span></div>
        <div class="nc-ref-item"><span class="dec">32</span><span class="arrow">&rarr;</span><span class="bin">100000</span></div>
        <div class="nc-ref-item"><span class="dec">64</span><span class="arrow">&rarr;</span><span class="bin">1000000</span></div>
        <div class="nc-ref-item"><span class="dec">128</span><span class="arrow">&rarr;</span><span class="bin">10000000</span></div>
        <div class="nc-ref-item"><span class="dec">255</span><span class="arrow">&rarr;</span><span class="bin">11111111</span></div>
        <div class="nc-ref-item"><span class="dec">256</span><span class="arrow">&rarr;</span><span class="bin">100000000</span></div>
      </div>
    </div>
  </div>
{% endblock %}

{% block description %}
  {% include "tool-description.njk" %}
{% endblock %}

{% block tool_script %}
  <script>
    (function () {
      'use strict';

      var decimalInput = document.getElementById('decimal-input');
      var binaryOutput = document.getElementById('binary-output');
      var hexOutput    = document.getElementById('hex-output');
      var octalOutput  = document.getElementById('octal-output');
      var outputCard   = document.getElementById('output-card');
      var hexCard      = document.getElementById('hex-card');
      var octalCard    = document.getElementById('octal-card');
      var btnConvert   = document.getElementById('btn-convert');
      var btnClear     = document.getElementById('btn-clear');
      var btnCopy      = document.getElementById('btn-copy');
      var statusMessage = document.getElementById('status-message');
      var statusDot     = document.getElementById('status-dot');
      var statusText    = document.getElementById('status-text');

      function showPrimary(text, type) {
        binaryOutput.textContent = text;
        binaryOutput.className = 'tool-output-value';
        if (type === 'empty') binaryOutput.className += ' empty';
        else if (type === 'error') binaryOutput.className += ' error';
        if (type === 'valid') outputCard.classList.add('has-result');
        else outputCard.classList.remove('has-result');
      }

      function showSecondary(el, card, text, type) {
        el.textContent = text;
        el.className = 'nc-secondary-value';
        if (type === 'empty') el.className += ' empty';
        if (type === 'valid') card.classList.add('has-result');
        else card.classList.remove('has-result');
      }

      function convert() {
        var input = decimalInput.value.replace(/\s/g, '');
        if (!input) {
          showPrimary('Result will appear here', 'empty');
          showSecondary(hexOutput, hexCard, '—', 'empty');
          showSecondary(octalOutput, octalCard, '—', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
          return;
        }
        try {
          var result = BigInt(input);
          showPrimary(result.toString(2), 'valid');
          showSecondary(hexOutput, hexCard, result.toString(16).toUpperCase(), 'valid');
          showSecondary(octalOutput, octalCard, result.toString(8), 'valid');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'valid', 'Converted');
        } catch (e) {
          showPrimary('Invalid decimal input', 'error');
          showSecondary(hexOutput, hexCard, '—', 'empty');
          showSecondary(octalOutput, octalCard, '—', 'empty');
          ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'invalid', 'Invalid decimal input');
        }
      }

      btnConvert.onclick = convert;

      btnClear.addEventListener('click', function () {
        decimalInput.value = '';
        showPrimary('Result will appear here', 'empty');
        showSecondary(hexOutput, hexCard, '—', 'empty');
        showSecondary(octalOutput, octalCard, '—', 'empty');
        ToolCommon.updateStatus(statusMessage, statusDot, statusText, 'idle', '');
      });

      btnCopy.addEventListener('click', function () {
        var text = binaryOutput.textContent;
        if (text && !binaryOutput.classList.contains('empty') && !binaryOutput.classList.contains('error')) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btnCopy.innerHTML;
            btnCopy.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!';
            btnCopy.classList.add('copied');
            setTimeout(function () { btnCopy.innerHTML = orig; btnCopy.classList.remove('copied'); }, 1500);
          });
        }
      });

      decimalInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') btnConvert.click();
      });

      // Live conversion on input
      decimalInput.addEventListener('input', convert);

      ToolCommon.initExampleCopy();
    })();
  </script>
{% endblock %}
